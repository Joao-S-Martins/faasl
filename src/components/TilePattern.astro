---
// An azulejo-inspired tile pattern recolored into the brand palette
// (docs/brand.md, Portuguese motifs). Use as a band, divider or background.
interface Props {
  /** Pattern colors: background, main shape, accent. */
  colors?: { ground: string; shape: string; accent: string };
  height?: string;
  tile?: number;
  label?: string;
}

const {
  colors = {
    ground: 'var(--color-white)',
    shape: 'var(--color-hunter-green)',
    accent: 'var(--color-gold)',
  },
  height = '6rem',
  tile = 48,
} = Astro.props;
const id = `tile-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="tiles" style={`height:${height}`} aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width={tile} height={tile} patternUnits="userSpaceOnUse" viewBox="0 0 48 48">
      <rect width="48" height="48" fill={colors.ground}></rect>
      <path
        d="M24 4 C30 14 34 18 44 24 C34 30 30 34 24 44 C18 34 14 30 4 24 C14 18 18 14 24 4 Z"
        fill={colors.shape}
      ></path>
      <circle cx="24" cy="24" r="5" fill={colors.accent}></circle>
      <path
        d="M0 0 H8 A8 8 0 0 1 0 8 Z M48 0 V8 A8 8 0 0 1 40 0 Z M0 48 V40 A8 8 0 0 1 8 48 Z M48 48 H40 A8 8 0 0 1 48 40 Z"
        fill={colors.accent}
      ></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<style>
  .tiles {
    display: block;
    width: 100%;
    border-radius: var(--radius);
  }
</style>

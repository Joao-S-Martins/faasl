---
// Design directions, beta only (docs/todo.md, Phase 3). Each direction shows
// the home page and the Lessons page with the same content, presented two
// ways. Compare on a phone first.
import DesignLayout from '../../../layouts/DesignLayout.astro';
import HomeMock from '../../../components/design/HomeMock.astro';
import LessonsMock from '../../../components/design/LessonsMock.astro';
import { isProduction } from '../../../lib/site';

export function getStaticPaths() {
  if (isProduction) return [];
  return ['a', 'b', 'c'].flatMap((direction) =>
    ['home', 'lessons'].map((page) => ({ params: { direction, page } })),
  );
}

const { direction, page } = Astro.params as {
  direction: 'a' | 'b' | 'c';
  page: 'home' | 'lessons';
};
const base = `/design/${direction}`;
const names = { a: 'A, Tiles and paper', b: 'B, Photo-led', c: 'C, the mix' };
---

<DesignLayout title={`Direction ${names[direction]}: ${page}`} direction={direction}>
  {page === 'home' ? (
    <HomeMock direction={direction} base={base} />
  ) : (
    <LessonsMock direction={direction} />
  )}
</DesignLayout>

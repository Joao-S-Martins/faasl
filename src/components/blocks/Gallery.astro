---
// A grid of photos and short video clips that opens in a full-screen
// lightbox (PhotoSwipe: swipe, pinch-zoom, keyboard). Without JavaScript each
// thumbnail is a plain link to the full photo or clip, so it still works and
// search engines still see every photo, its alt text and caption.
// How to add one to an event: docs/event-writeups.md.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Play from '@lucide/astro/icons/play';

export type GalleryItem =
  | { image: ImageMetadata; alt: string; caption?: string }
  | { video: string; poster: ImageMetadata; alt: string; caption?: string };

interface Props {
  items: GalleryItem[];
  /** Names the gallery for screen readers, e.g. "Photos from the Spring concert". */
  label: string;
}

const { items, label } = Astro.props;

// The lightbox gets a full-size version (and smaller ones for phones);
// the grid gets square thumbnails.
const BIG = [800, 1600, 2400];
const slides = await Promise.all(
  items.map(async (item) => {
    const photo = 'image' in item ? item.image : item.poster;
    const widths = BIG.filter((w) => w < photo.width).concat(Math.min(photo.width, 2400));
    const full = await getImage({ src: photo, widths, format: 'webp', quality: 75 });
    const width = Math.max(...widths);
    return {
      ...item,
      photo,
      full,
      width,
      height: Math.round((width * photo.height) / photo.width),
    };
  }),
);
---

<ul class="gallery" aria-label={label} data-gallery>
  {slides.map((slide) => (
    <li>
      <figure>
        {'video' in slide ? (
          <a
            href={slide.video}
            class="video"
            data-video
            data-poster={slide.full.src}
            data-pswp-width={slide.width}
            data-pswp-height={slide.height}
            data-cropped="true"
          >
            <Image
              src={slide.photo}
              alt={`Video: ${slide.alt}`}
              width={600}
              widths={[300, 600]}
              sizes="(width >= 64rem) 16rem, (width >= 40rem) 33vw, 50vw"
              quality={65}
            />
            <span class="play" aria-hidden="true">
              <Play size={28} fill="currentColor" />
            </span>
          </a>
        ) : (
          <a
            href={slide.full.src}
            data-pswp-srcset={slide.full.srcSet.attribute}
            data-pswp-width={slide.width}
            data-pswp-height={slide.height}
            data-cropped="true"
          >
            <Image
              src={slide.photo}
              alt={slide.alt}
              width={600}
              widths={[300, 600]}
              sizes="(width >= 64rem) 16rem, (width >= 40rem) 33vw, 50vw"
              quality={65}
            />
          </a>
        )}
        {slide.caption && <figcaption>{slide.caption}</figcaption>}
      </figure>
    </li>
  ))}
</ul>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a',
      // The lightbox code only downloads when someone opens a photo.
      pswpModule: () => import('photoswipe'),
      bgOpacity: 1,
      // A tap on a clip is for its play button, not for closing.
      clickToCloseNonZoomable: false,
    });

    // Clips: play in the lightbox with the browser's own controls.
    lightbox.addFilter('itemData', (data) => {
      const link = data.element;
      if (link?.dataset.video !== undefined) {
        data.type = 'video';
        data.videoSrc = link.getAttribute('href');
        data.poster = link.dataset.poster;
      }
      return data;
    });
    lightbox.on('contentLoad', (event) => {
      const { content } = event;
      if (content.type !== 'video') return;
      event.preventDefault();
      const video = document.createElement('video');
      video.src = content.data.videoSrc;
      video.poster = content.data.poster;
      video.controls = true;
      video.playsInline = true;
      video.preload = 'metadata';
      content.element = document.createElement('div');
      content.element.className = 'pswp__content pswp__video';
      content.element.append(video);
    });
    // Let the video controls have their taps; swiping between slides still works.
    lightbox.addFilter('preventPointerEvent', (prevent, event) =>
      (event.target as Element).closest('video') ? false : prevent,
    );
    lightbox.on('contentDeactivate', ({ content }) => {
      content.element?.querySelector('video')?.pause();
    });

    // The caption under each slide.
    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (el, pswp) => {
          pswp.on('change', () => {
            const caption = pswp.currSlide?.data.element
              ?.closest('figure')
              ?.querySelector('figcaption')?.textContent;
            el.textContent = caption ?? '';
            el.hidden = !caption;
          });
        },
      });
    });

    lightbox.init();
  }
</script>

<style>
  @layer components {
    .gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-s);
      padding: 0;
      list-style: none;
    }

    @media (width >= 40rem) {
      .gallery {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (width >= 64rem) {
      .gallery {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    figure {
      margin: 0;
    }

    a {
      position: relative;
      display: block;
      overflow: hidden;
      border-radius: var(--r-control);
    }

    a:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }

    img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      transition: transform var(--duration-fast) ease-out;
    }

    a:hover img {
      transform: scale(1.03);
    }

    .play {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: var(--color-white);
    }

    .play :global(svg) {
      box-sizing: content-box;
      padding: 0.75rem;
      border-radius: 50%;
      background: rgb(0 0 0 / 0.55);
    }

    figcaption {
      margin-top: var(--space-xs);
      font-size: var(--step--1);
    }

    /* The lightbox lives outside this component, at the end of <body>. */
    :global(.pswp__caption) {
      position: absolute;
      inset: auto 0 0;
      padding: var(--space-s) var(--gutter) var(--space-m);
      background: linear-gradient(transparent, rgb(0 0 0 / 0.7));
      color: var(--color-white);
      text-align: center;
    }

    :global(.pswp__video video) {
      width: 100%;
      height: 100%;
      background: black;
    }
  }
</style>

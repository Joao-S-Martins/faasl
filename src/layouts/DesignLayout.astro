---
// Layout for the design directions (/design/<direction>/<page>), beta only.
// The element marked [data-landing] is the landing image: while it's in
// view the header is large and the floating Donate button is hidden.
// Without JavaScript the header stays compact and the button visible.
import BaseLayout from './BaseLayout.astro';
import DesignHeader from '../components/design/DesignHeader.astro';
import DonateButton from '../components/design/DonateButton.astro';
import DesignFooter from '../components/design/DesignFooter.astro';

interface Props {
  title: string;
  direction: 'a' | 'b' | 'c';
}

const { title, direction } = Astro.props;
const base = `/design/${direction}`;
---

<BaseLayout title={title} description="Design direction (beta only)." noindex>
  <script is:inline>
    document.documentElement.dataset.hero = 'in';
  </script>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <DesignHeader look={direction === 'a' ? 'solid' : 'over-photo'} base={base} />
  <main id="main" class={`direction-${direction}`}>
    <slot />
  </main>
  <DesignFooter />
  <DonateButton />
</BaseLayout>

<script>
  const landing = document.querySelector('[data-landing]');
  const root = document.documentElement;
  if (landing) {
    // "out" once only the bottom 15% of the landing image is left on screen
    new IntersectionObserver(
      ([entry]) => {
        root.dataset.hero = entry.isIntersecting ? 'in' : 'out';
      },
      { rootMargin: '0px 0px -85% 0px' },
    ).observe(landing);
  } else {
    root.dataset.hero = 'out';
  }
</script>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
  }

  .skip-link:focus {
    left: var(--gutter);
    top: var(--gutter);
    z-index: 30;
    padding: var(--space-xs) var(--space-s);
    background: var(--color-white);
  }
</style>

---
// A titled page section. Every page is built from these, so section-level
// design changes happen here.
interface Props {
  title: string;
  id?: string;
  subtitle?: string;
  /** Heading level for the title (default h2). */
  level?: 2 | 3;
}

const { title, subtitle, level = 2 } = Astro.props;
const id =
  Astro.props.id ??
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const Heading = `h${level}` as 'h2' | 'h3';
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <header class="section-header">
    <Heading id={`${id}-title`}>{title}</Heading>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </header>
  <slot />
</section>

<style>
  .section {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-l);
    border-top: 1px solid #ddd;
  }

  .subtitle {
    font-size: var(--step-1);
  }
</style>

---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import Surface from '../components/blocks/Surface.astro';
import ButtonRow from '../components/blocks/ButtonRow.astro';
import Button from '../components/blocks/Button.astro';
import FactRow from '../components/blocks/FactRow.astro';
import MediaFeature from '../components/blocks/MediaFeature.astro';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import Clock from '@lucide/astro/icons/clock';
import MapPin from '@lucide/astro/icons/map-pin';
import PeopleList from '../components/content/PeopleList.astro';
import Testimonial from '../components/content/Testimonial.astro';
import { getScheduleMap } from '../lib/schedule';
import { getSite } from '../lib/site';
import growing from '../assets/photos/growing-together.jpg';
import church from '../assets/photos/band-in-church.jpg';
import brass from '../assets/photos/brass-close-up.jpg';

const site = await getSite();
const s = await getScheduleMap();
---

<PageLayout
  title="Join the Band"
  description="Join a free community band in San Leandro, CA. Experienced and aspiring musicians welcome, no audition. Concert and marching music, festas, parades and festivals."

  hero
  bare
>
  <Hero
    image={growing}
    alt="Musicians of different ages marching and playing together in uniform"
    size="page"
    surface="tint"
  >
    <h1>Join the Band</h1>
    <p class="sub">a community band for experienced and aspiring musicians alike</p>
  </Hero>

  <Surface surface="tint">
    <div class="stack measure">
      <p>
        Whether you've played for decades or your instrument's been collecting dust, there's a seat
        for you in our volunteer band. We're a mixed-age group of new and experienced musicians,
        dedicated to improving one another as much as ourselves. Younger musicians play alongside
        older ones, learning in a way that simply can't be replicated in a peer-aged group.
        Experienced musicians take pride in helping the next generation while growing their own
        skills with a challenging and changing repertoire.
      </p>
      <p>
        <strong>Just show up.</strong> There are no auditions and no sign-up. Bring your instrument
        to any rehearsal; we always have extra sheet music ready for you to read.
      </p>
    </div>
  </Surface>

  <Surface>
    <MediaFeature
      image={church}
      alt="The band in green uniforms performing inside a church"
      side="left"
    >
      <h2 id="what-we-play">What we play</h2>
      <p>
        We play concert band and marching music, and we perform around the SF Bay and Central Valley
        every year:
      </p>
      <ul>
        <li>
          <strong>Holy Ghost parades:</strong> hosted by Portuguese communities throughout the year
        </li>
        <li>
          <strong>Music festivals:</strong> we host guest bands, or they host us
        </li>
        <li>
          <strong>City events:</strong> the Cherry Festival parade and others
        </li>
        <li>
          <strong>Caroling:</strong> bringing cheer to the holiday season
        </li>
      </ul>
    </MediaFeature>
  </Surface>

  <Surface title="Rehearsals" surface="green" pattern="field">
    <FactRow
      facts={[
        {
          icon: CalendarDays,
          label: 'When',
          value: `${s.band.day}s`,
          detail: `${s.band.time}, right after lessons`,
        },
        { icon: Clock, label: 'How long', value: s.band.length, detail: s.band.note },
        {
          icon: MapPin,
          label: 'Where',
          value: 'Our clubhouse',
          detail: `${site.clubhouse.street}, ${site.clubhouse.city}`,
        },
      ]}
    />
  </Surface>

  <Surface title="Our conductors">
    <div class="stack">
      <PeopleList role="conductor" />
    </div>
  </Surface>

  <Surface surface="tint">
    <MediaFeature image={brass} alt="Brass and saxophone players reading their music" side="right">
      <h2 id="coming-back">Coming back to music, or starting fresh?</h2>
      <p>
        That instrument in the back of your closet still has music in it. Many of our members
        returned to playing after years away, and the band is a welcoming place to rediscover it.
        Adults are also welcome to start from scratch: our <a href="/lessons">free lessons</a> teach
        beginners of any age, and many band members use the intermediate class to brush up or learn
        a second instrument.
      </p>
      <Testimonial audience="musicians" pick={2} />
    </MediaFeature>
  </Surface>

  <Surface title="Ready to play?" align="center">
    <div class="stack">
      <p>Come to the next rehearsal. Questions first?</p>
      <ButtonRow>
        <Button href="/contact">Contact us</Button>
      </ButtonRow>
    </div>
  </Surface>
</PageLayout>

---
// Tile patterns built from musical motifs (staff lines, notes, fermatas,
// sharps), drawn like hand-painted tiles in the brand colors
// (docs/brand.md, Portuguese motifs). Decorative only.
interface Props {
  variant?: 'staff' | 'rosette' | 'subtle';
  /** Line color (hunter green by default) and accent (gold, used sparingly). */
  ink?: string;
  accent?: string;
  ground?: string;
  /** Wall tiles (staff, rosette): the gap between tiles. */
  grout?: string;
  height?: string;
  tile?: number;
  /** Rounded outline around the whole pattern; off for bands and panels. */
  frame?: boolean;
}

const {
  variant = 'staff',
  ink = 'var(--color-hunter-green)',
  accent = 'var(--color-gold)',
  ground = 'var(--color-white)',
  grout = 'var(--color-off-white)',
  height = '7rem',
  tile = 96,
  frame = true,
} = Astro.props;
const id = `tile-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const width = variant === 'subtle' ? tile * 2 : tile;

// Shared by the wall tiles (staff, rosette): a square face inside a grout
// margin, with corner motifs drawn from the face corners so nothing crosses
// the grout. Four neighbors complete each corner ring by eye.
const cornerArcs =
  'M3 19 A16 16 0 0 0 19 3 M77 3 A16 16 0 0 0 93 19 M93 77 A16 16 0 0 0 77 93 M19 93 A16 16 0 0 0 3 77';
const cornerDots =
  'M3 3 H10 A7 7 0 0 1 3 10 Z M93 3 V10 A7 7 0 0 1 86 3 Z M93 93 H86 A7 7 0 0 1 93 86 Z M3 93 V86 A7 7 0 0 1 10 93 Z';
---

<svg
  class:list={['tiles', { frame }]}
  style={`height:${height}`}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    {variant === 'staff' && (
      <pattern id={id} width={tile} height={tile} patternUnits="userSpaceOnUse" viewBox="0 0 96 96">
        <rect width="96" height="96" fill={grout} />
        <rect x="3" y="3" width="90" height="90" fill={ground} />
        <path d={cornerArcs} fill="none" stroke={ink} stroke-width="1.5" />
        <path d={cornerDots} fill={accent} />
        <g fill="none" stroke={ink} stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="90" height="90" stroke-width="1" />
          {/* staff */}
          <path d="M14 40 H82 M14 46 H82 M14 52 H82 M14 58 H82 M14 64 H82" stroke-width="1.2" />
          {/* sharp */}
          <path d="M21 41 V61 M25 39 V59 M18 49 L28 46 M18 55 L28 52" stroke-width="1.4" />
          {/* beamed eighth notes and a quarter note */}
          <path d="M43.5 58 V32 M57.5 52 V30 M71.5 61 V37" stroke-width="1.6" />
          <path d="M43.5 32 L57.5 30" stroke-width="4" />
          {/* fermata */}
          <path d="M38 24 A10 9 0 0 1 58 24" stroke-width="1.8" />
        </g>
        <g fill={ink}>
          <ellipse cx="40" cy="58" rx="4.2" ry="3" transform="rotate(-22 40 58)" />
          <ellipse cx="54" cy="52" rx="4.2" ry="3" transform="rotate(-22 54 52)" />
          <ellipse cx="68" cy="61" rx="4.2" ry="3" transform="rotate(-22 68 61)" />
          <circle cx="48" cy="22" r="1.8" fill={accent} />
        </g>
      </pattern>
    )}
    {variant === 'rosette' && (
      <pattern id={id} width={tile} height={tile} patternUnits="userSpaceOnUse" viewBox="0 0 96 96">
        {/* grout between tiles, then the tile itself */}
        <rect width="96" height="96" fill={grout} />
        <rect x="3" y="3" width="90" height="90" fill={ground} />
        <path d={cornerArcs} fill="none" stroke={ink} stroke-width="1.5" />
        <path d={cornerDots} fill={accent} />
        <g fill="none" stroke={ink} stroke-linecap="round" stroke-width="1.5">
          <rect x="3" y="3" width="90" height="90" stroke-width="1" />
          <circle cx="48" cy="48" r="35" />
          <circle cx="48" cy="48" r="9" stroke={accent} stroke-width="2" />
        </g>
        {/* beamed eighth notes, turned four times. Stems up on the right of
            the notehead, as written; a beam instead of flags, so the turn
            never reads as a pinwheel. */}
        {[0, 90, 180, 270].map((angle) => (
          <g
            transform={`rotate(${angle} 48 48) translate(48 48) scale(1.15) translate(-48 -48)`}
            fill={ink}
          >
            <path
              d="M45.4 35.4 V23 M55.4 35.4 V23"
              fill="none"
              stroke={ink}
              stroke-width="1.6"
              stroke-linecap="round"
            />
            <path d="M45.4 24 H55.4" stroke={ink} stroke-width="3.5" />
            <ellipse cx="42" cy="36" rx="3.8" ry="2.7" transform="rotate(-22 42 36)" />
            <ellipse cx="52" cy="36" rx="3.8" ry="2.7" transform="rotate(-22 52 36)" />
          </g>
        ))}
      </pattern>
    )}
    {variant === 'subtle' && (
      <pattern
        id={id}
        width={width}
        height={tile / 2}
        patternUnits="userSpaceOnUse"
        viewBox="0 0 192 48"
      >
        <rect width="192" height="48" fill={ground} />
        <g fill="none" stroke={ink} stroke-width="1" opacity="0.18">
          <path d="M0 12 H192 M0 18 H192 M0 24 H192 M0 30 H192 M0 36 H192" />
          <path
            d="M43 33 V13 M99 27 V9 M151 36 V16 M151 16 C156 19 159 21 157 26"
            stroke-width="1.4"
          />
        </g>
        <g fill={ink} opacity="0.18">
          <ellipse cx="40" cy="33" rx="3.6" ry="2.6" transform="rotate(-22 40 33)" />
          <ellipse cx="96" cy="27" rx="3.6" ry="2.6" transform="rotate(-22 96 27)" />
          <ellipse cx="148" cy="36" rx="3.6" ry="2.6" transform="rotate(-22 148 36)" />
        </g>
      </pattern>
    )}
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<style>
  .tiles {
    display: block;
    width: 100%;
  }

  .frame {
    border-radius: var(--radius);
    border: 1px solid #ddd;
  }
</style>

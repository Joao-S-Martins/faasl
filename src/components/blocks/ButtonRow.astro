---
// A row of calls to action (Buttons, LinkMores or plain links), wrapping on
// narrow screens.
---

<div class="button-row">
  <slot />
</div>

<style>
  @layer components {
    .button-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-s) var(--space-m);
      margin-top: calc(var(--space-s) * 2);
    }
  }
</style>

---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<PageLayout title="Page not found" description="This page doesn't exist." noindex>
  <PageHeader title="Page not found">
    <p>Sorry, we couldn't find that page. Try one of these:</p>
    <ul>
      <li>
        <a href="/">Home</a>
      </li>
      <li>
        <a href="/lessons">Free music lessons</a>
      </li>
      <li>
        <a href="/contact">Contact us</a>
      </li>
      <li>
        Looking for an event? It may have already passed: see <a href="/events">upcoming events</a>
      </li>
    </ul>
  </PageHeader>
</PageLayout>

---
// Key facts as a description list: "Cost — Free", "Ages — 8 to 108".
interface Props {
  facts: { term: string; detail: string }[];
}

const { facts } = Astro.props;
---

<dl class="facts">
  {facts.map(({ term, detail }) => (
    <div>
      <dt>{term}</dt>
      <dd>{detail}</dd>
    </div>
  ))}
</dl>

<style>
  .facts {
    display: grid;
    gap: var(--space-xs);
  }

  .facts div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-s);
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }
</style>

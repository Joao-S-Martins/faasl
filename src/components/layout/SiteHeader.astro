---
import { mainNav } from '../../lib/navigation';
import { getSite, publicPath } from '../../lib/site';
import logo from '../../assets/logo.svg';

const site = await getSite();
const current = publicPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <img src={logo.src} alt="" width="40" height="40" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {mainNav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={current === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="donate" href="/give">
      Donate
    </a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid #ddd;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-s);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 700;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    font-weight: 700;
  }

  .donate {
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius);
    background: var(--color-hunter-green);
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }
</style>

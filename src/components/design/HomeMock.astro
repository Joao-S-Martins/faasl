---
// The home page in each design direction (docs/brief.md §3.1). Same copy as
// the current home page; only the presentation differs.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import EighthNotes from '@lucide/astro/icons/eighth-notes';
import HandHeart from '@lucide/astro/icons/hand-heart';
import Users from '@lucide/astro/icons/users';
import Flag from '@lucide/astro/icons/flag';
import CalendarHeart from '@lucide/astro/icons/calendar-heart';
import Band from './Band.astro';
import Feature from './Feature.astro';
import StatGrid from './StatGrid.astro';
import PhotoBand from './PhotoBand.astro';
import EventCards from './EventCards.astro';
import TilePattern from '../TilePattern.astro';
import ButtonLink from '../ButtonLink.astro';
import Actions from '../Actions.astro';
import Testimonial from '../Testimonial.astro';
import PeopleGrid from '../PeopleGrid.astro';
import Address from '../Address.astro';
import Todo from '../Todo.astro';
import { getSite, yearsSince } from '../../lib/site';
import { fillTokens } from '../../lib/schedule';
import bandSteps from '../../assets/photos/band-church-steps.jpg';
import rehearsal from '../../assets/photos/students-rehearsal.jpg';
import young from '../../assets/photos/young-members.jpg';
import together from '../../assets/photos/growing-together.jpg';
import parade from '../../assets/photos/parade-carnival.jpg';

interface Props {
  direction: 'a' | 'b';
  base: string;
}

const { direction: d, base } = Astro.props;
const site = await getSite();
const impact = (await getEntry('impact', 'current'))!.data;
const schedule = await fillTokens('{{schedule}}');
const number = (text: string) => text.replace(/^about\s+/i, '');

const paths = [
  {
    icon: GraduationCap,
    title: 'Learn an instrument',
    text: 'Free lessons, ages 8 to 108',
    href: `${base}/lessons`,
  },
  {
    icon: EighthNotes,
    title: 'Play in the band',
    text: 'No auditions, Friday nights',
    href: '/join',
  },
  { icon: HandHeart, title: 'Give', text: 'Keep music free', href: '/give' },
];

const stats = [
  {
    icon: CalendarHeart,
    value: `${yearsSince(site.foundingYear)}`,
    label: `years of music, since ${site.foundingYear}`,
  },
  { icon: Users, value: impact.bandMusicians, label: 'musicians in the band' },
  {
    icon: GraduationCap,
    value: impact.studentsPerClassPerYear.replace(/^about\s+/i, ''),
    label: 'students per class each year',
  },
  {
    icon: Flag,
    value: number(impact.paradesPerYear),
    label: `parades and ${number(impact.concertsPerYear)} concerts a year`,
  },
];
---

<section class:list={['hero', d]} data-landing>
  <Image
    src={bandSteps}
    alt="The full band in green uniforms on church steps, with flags"
    width={1600}
    widths={[640, 1000, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-photo"
  />
  <div class="hero-text">
    <h1>We've built a community around music</h1>
    <p class="sub">and you're invited to join us</p>
    <p>
      Free music lessons, a band for every age and skill level, and live music for our community,
      since {site.foundingYear}.
    </p>
    <Todo block>
      a short silent video loop here (the photo shows first; no video for reduced motion or slow
      connections)
    </Todo>
  </div>
</section>

<nav class:list={['paths', d]} aria-label="I want to…">
  <ul>
    {paths.map(({ icon: Icon, title, text, href }) => (
      <li>
        <a href={href}>
          <Icon size={36} stroke-width={1.5} aria-hidden="true" />
          <strong>{title}</strong>
          <span>{text}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<Band bg={d === 'a' ? 'white' : 'tint'}>
  <Feature
    image={rehearsal}
    alt="Students rehearsing with the conductor"
    side="left"
    tone={d === 'a' ? 'white' : 'white'}
  >
    <h2>Free lessons for ages 8 to 108</h2>
    <p>
      Every lesson we teach is free. Our music teacher, who also teaches in San Leandro schools,
      guides beginner and intermediate students on woodwinds, brass and percussion, and you can
      start any time of year.
    </p>
    <p>{schedule}</p>
    <Actions>
      <ButtonLink href={`${base}/lessons`}>Learn with us</ButtonLink>
    </Actions>
  </Feature>
</Band>

{d === 'a' ? (
  <>
    <Band>
      <Feature image={young} alt="Young members of the band in uniform" side="right" tone="tint">
        <h2>A band for every age and skill level</h2>
        <p>
          Our volunteer band is a mixed-age group of {impact.bandMusicians} musicians. Younger
          musicians play alongside experienced ones, learning in a way a peer-aged group can't
          match. No auditions: just show up on a Friday night.
        </p>
        <Actions>
          <ButtonLink href="/join">Join the band</ButtonLink>
        </Actions>
      </Feature>
    </Band>
    <Band bg="tint">
      <h2 class="center">Music in our community</h2>
      <StatGrid stats={stats} />
    </Band>
    <TilePattern variant="staff" tile={64} height="64px" frame={false} center="x" />
    <Band bg="field" narrow>
      <div class="quote-box">
        <Testimonial audience="musicians" />
      </div>
    </Band>
    <Band bg="green">
      <div class="give">
        <h2>Your support is instrumental</h2>
        <p>
          Our lessons are free, our band runs on volunteers, and our board isn't paid. Every dollar
          goes to our building and our musical needs: sheet music, uniforms, instrument repairs and
          the carpools that get us to performances.
        </p>
        <Actions>
          <a class="button-light" href="/give">
            Give
          </a>
          <a href="/impact">See our impact</a>
        </Actions>
      </div>
    </Band>
  </>
) : (
  <>
    <Band bg="field-green">
      <h2 class="center">Music in our community</h2>
      <StatGrid stats={stats} tone="dark" />
    </Band>
    <PhotoBand
      image={together}
      alt="Musicians of different generations playing together"
      align="right"
      tone="white"
    >
      <Testimonial audience="musicians" />
    </PhotoBand>
    <Band>
      <Feature image={young} alt="Young members of the band in uniform" side="right" tone="tint">
        <h2>A band for every age and skill level</h2>
        <p>
          Our volunteer band is a mixed-age group of {impact.bandMusicians} musicians. Younger
          musicians play alongside experienced ones, learning in a way a peer-aged group can't
          match. No auditions: just show up on a Friday night.
        </p>
        <Actions>
          <ButtonLink href="/join">Join the band</ButtonLink>
        </Actions>
      </Feature>
    </Band>
    <section class="give-wall">
      <div class="wall">
        <TilePattern variant="checker" tile={96} height="100%" frame={false} center="both" />
      </div>
      <div class="give-box">
        <h2>Your support is instrumental</h2>
        <p>
          Our lessons are free, our band runs on volunteers, and our board isn't paid. Every dollar
          goes to our building and our musical needs: sheet music, uniforms, instrument repairs and
          the carpools that get us to performances.
        </p>
        <Actions>
          <ButtonLink href="/give">Give</ButtonLink>
          <a href="/impact">See our impact</a>
        </Actions>
      </div>
    </section>
  </>
)}

<Band bg={d === 'a' ? 'white' : 'tint'}>
  <h2>Come see us</h2>
  <p class="lead">
    We play about a dozen parades and half a dozen concerts every year, and host fundraiser dinners
    with classic Portuguese meals.
  </p>
  <EventCards />
  <p>
    <a href="/events">All events</a>
  </p>
</Band>

{d === 'b' && (
  <figure class="parade">
    <Image
      src={parade}
      alt="The band marching in a parade"
      width={1600}
      widths={[640, 1000, 1600]}
      sizes="100vw"
    />
  </figure>
)}

<Band bg={d === 'a' ? 'tint' : 'white'}>
  <h2>Our leadership</h2>
  <PeopleGrid role="leadership" compact />
  <p>
    <a href="/about">Meet the team</a>
  </p>
</Band>

<Band bg={d === 'a' ? 'white' : 'tint'}>
  <div class="visit">
    <div>
      <h2>Visit us</h2>
      <Address directions />
    </div>
    <p>
      <a href={`tel:+1${site.phone.replace(/\D/g, '')}`}>{site.phone}</a>
      <br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <br />
      <a href="/contact">Contact us</a>
    </p>
  </div>
</Band>

<style>
  /* Hero */
  .hero {
    position: relative;
    display: grid;
  }

  .hero-photo {
    width: 100%;
    object-fit: cover;
  }

  .hero.a {
    padding-top: 6rem;
  }

  .hero.a .hero-photo {
    height: clamp(16rem, 55svh, 34rem);
  }

  .hero.a .hero-text {
    position: relative;
    width: min(100% - 2 * var(--gutter), 40rem);
    margin: -4rem auto 0;
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .hero.b {
    min-height: max(26rem, min(100svh, 56rem));
    color: var(--color-white);
  }

  .hero.b .hero-photo {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .hero.b::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 35%, rgb(0 0 0 / 0.7));
  }

  .hero.b .hero-text {
    position: relative;
    z-index: 1;
    align-self: end;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: 6rem var(--gutter) var(--space-l);
  }

  .hero.b h1 {
    color: inherit;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    max-width: 14em;
  }

  .hero-text > * + * {
    margin-top: var(--space-xs);
  }

  .sub {
    font-size: var(--step-1);
    font-weight: 600;
  }

  /* "I want to…" */
  .paths ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paths a {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-s);
    align-items: center;
    padding: var(--space-m) var(--gutter);
    text-decoration: none;
  }

  .paths a :global(svg) {
    grid-row: span 2;
  }

  .paths strong {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .paths.a {
    padding: var(--space-l) var(--gutter) 0;
  }

  .paths.a ul {
    gap: var(--space-s);
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .paths.a a {
    border: 2px solid var(--color-hunter-green);
    border-radius: var(--radius);
    color: var(--color-hunter-green);
  }

  .paths.a a:hover {
    background: var(--color-off-white);
  }

  /* B: boxes butt against each other and the hero, so their corners are sharp */
  .paths.b ul {
    gap: 2px;
    background: var(--color-gold);
  }

  .paths.b a {
    background: var(--color-hunter-green);
    color: var(--color-white);
  }

  .paths.b a:hover {
    background: #2b473b;
  }

  @media (min-width: 48rem) {
    .paths ul {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero.a .hero-text {
      margin: -6rem 0 0 max(var(--gutter), (100% - var(--content-width)) / 2 + var(--gutter));
      padding: var(--space-l);
    }
  }

  .center {
    text-align: center;
    margin-bottom: var(--space-l);
  }

  .lead {
    margin-bottom: var(--space-m);
  }

  .quote-box {
    padding: var(--space-l);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
  }

  .give {
    max-width: 44rem;
  }

  .give > * + * {
    margin-top: var(--space-s);
  }

  .button-light {
    display: inline-block;
    padding: 0.625rem 1.125rem;
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-hunter-green) !important;
    font-weight: 700;
    text-decoration: none;
  }

  /* B: the Give box cuts into a tile wall */
  .give-wall {
    position: relative;
    display: grid;
  }

  .wall {
    height: 12rem;
  }

  .give-box {
    padding: var(--space-l) var(--gutter);
    background: var(--color-white);
  }

  .give-box > * + * {
    margin-top: var(--space-s);
  }

  @media (min-width: 48rem) {
    .give-wall {
      grid-template-columns: 1fr minmax(0, 36rem) var(--space-xl);
      min-height: 30rem;
      align-items: center;
    }

    .wall {
      position: absolute;
      inset: 0;
      height: auto;
    }

    .give-box {
      position: relative;
      grid-column: 2;
      padding: var(--space-l);
      border-radius: var(--radius);
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.15);
    }
  }

  .parade img {
    width: 100%;
    height: clamp(12rem, 40vw, 28rem);
    object-fit: cover;
  }

  .visit {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 48rem) {
    .visit {
      grid-template-columns: 2fr 1fr;
      align-items: end;
    }
  }
</style>

---
// A pull quote from a member story, picked for an audience.
import { getCollection } from 'astro:content';
import { isVisible } from '../lib/site';
import Todo from './Todo.astro';

type Audience = 'students' | 'families' | 'musicians' | 'donors' | 'funders';

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
const [story] = await getCollection(
  'stories',
  (entry) => isVisible(entry) && entry.data.audiences.includes(audience),
);
---

{story ? (
  <figure class="testimonial">
    <blockquote>
      <p>“{story.data.quote}”</p>
    </blockquote>
    <figcaption>— {story.data.name}</figcaption>
  </figure>
) : (
  <Todo block>a quote for {audience} (from the new member stories)</Todo>
)}

<style>
  .testimonial {
    margin: 0;
    padding-left: var(--space-s);
    border-left: 4px solid var(--color-accent);
  }

  blockquote {
    margin: 0;
    font-size: var(--step-1);
  }
</style>

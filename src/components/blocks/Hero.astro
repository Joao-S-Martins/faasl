---
// The landing photo at the top of a page, with the title box overlapping its
// bottom edge so the heading never depends on the photo for contrast.
// Marked [data-landing] for the header (pass `hero` to PageLayout).
//   size:    home (tall) · page (inner pages)
//   surface: the color around the box, matching the section below so the
//            two read as one
// The box content (h1, text) goes in the default slot.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Todo from '../layout/Todo.astro';
import { isProduction } from '../../lib/site';

interface Props {
  /** Leave out while the photo is missing: beta shows a placeholder naming
      the photo needed; production shows the title box alone. */
  image?: ImageMetadata;
  alt?: string;
  /** The photo this page needs, shown in the placeholder (docs/todo.md, Photos). */
  needs?: string;
  size?: 'home' | 'page';
  surface?: 'plain' | 'tint' | 'green';
  /** Where to keep the photo's subject when it's cropped on phones. */
  focus?: string;
}

const {
  image,
  alt = '',
  needs = 'a photo',
  size = 'home',
  surface = 'plain',
  focus = 'center 30%',
} = Astro.props;
const placeholder = !image && !isProduction;
---

<section
  class:list={['hero', size, surface]}
  data-landing
  data-on={surface === 'green' ? 'dark' : 'light'}
  style={`--focus-point: ${focus}`}
>
  {image ? (
    <Image
      src={image}
      alt={alt}
      width={2000}
      widths={[640, 1000, 1600, 2000]}
      sizes="100vw"
      quality={70}
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
  ) : (
    placeholder && (
      <div class="photo missing">
        <Todo block>hero photo: {needs} (docs/todo.md, Photos)</Todo>
      </div>
    )
  )}
  <div class:list={['box', { alone: !image && !placeholder }]} data-on="light">
    <slot />
  </div>
</section>

<style>
  @layer components {
    .hero {
      display: grid;
      padding-bottom: var(--space-m);
    }

    .plain {
      background: var(--color-white);
    }

    .tint {
      background: var(--color-off-white);
    }

    .green {
      background: var(--color-hunter-green);
    }

    .photo {
      width: 100%;
      object-fit: cover;
      object-position: var(--focus-point);
    }

    .home .photo {
      height: clamp(20rem, 62svh, 38rem);
    }

    .page .photo {
      height: clamp(14rem, 45svh, 28rem);
    }

    .missing {
      display: grid;
      place-items: center;
      padding: calc(var(--header-h-large) + var(--space-m)) var(--gutter) 5rem;
      background: repeating-linear-gradient(
        -45deg,
        var(--color-off-white) 0 12px,
        var(--color-white) 12px 24px
      );
    }

    /* no photo in production yet: the box sits below the header, no overlap
       (two classes, so it wins over the overlap margins below) */
    .box.alone {
      margin-top: calc(var(--header-h) + var(--space-m));
    }

    .box {
      position: relative;
      width: min(100% - 2 * var(--gutter), 40rem);
      margin: -4rem auto 0;
      padding: var(--space-m);
      border-radius: var(--r-box);
      background: var(--color-white);
      box-shadow: var(--shadow-float);
    }

    .page .box {
      margin-top: -3rem;
    }

    .box > :global(* + *) {
      margin-top: var(--space-xs);
    }

    /* the line under the h1 */
    .box > :global(.sub) {
      font-size: var(--step-1);
      font-weight: 600;
    }

    @media (width >= 40rem) {
      .photo {
        object-position: center;
      }
    }

    @media (width >= 64rem) {
      .box {
        width: min(100% - 2 * var(--gutter), 44rem);
        margin: -6rem 0 0 max(var(--gutter), (100% - var(--content-width)) / 2);
        padding: var(--space-l);
      }

      .page .box {
        margin-top: -5rem;
      }
    }
  }
</style>

---
// Lessons: everything a family needs to start (docs/design-system.md §6).
import { getCollection, getEntry } from 'astro:content';
import BadgeDollarSign from '@lucide/astro/icons/badge-dollar-sign';
import Cake from '@lucide/astro/icons/cake';
import Clock from '@lucide/astro/icons/clock';
import DoorOpen from '@lucide/astro/icons/door-open';
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import Surface from '../components/blocks/Surface.astro';
import FactRow from '../components/blocks/FactRow.astro';
import StepRow from '../components/blocks/StepRow.astro';
import TileBand from '../components/blocks/TileBand.astro';
import MediaFeature from '../components/blocks/MediaFeature.astro';
import QuoteBox from '../components/blocks/QuoteBox.astro';
import Quote from '../components/blocks/Quote.astro';
import Accordion from '../components/blocks/Accordion.astro';
import Button from '../components/blocks/Button.astro';
import ButtonRow from '../components/blocks/ButtonRow.astro';
import PeopleList from '../components/content/PeopleList.astro';
import InstrumentPicker from '../components/blocks/InstrumentPicker';
import StoreList from '../components/content/StoreList.astro';
import MapEmbed from '../components/blocks/MapEmbed.astro';
import CalendarLink from '../components/content/CalendarLink.astro';
import EventList from '../components/content/EventList.astro';
import FaqList from '../components/content/FaqList.astro';
import Todo from '../components/layout/Todo.astro';
import { getScheduleMap } from '../lib/schedule';
import { getSite } from '../lib/site';
import rehearsal from '../assets/photos/students-rehearsal.jpg';
import gym from '../assets/photos/concert-band-gym.jpg';

const site = await getSite();
const s = await getScheduleMap();
const program = (await getEntry('lessons', 'program'))!.data;
const instruments = (await getCollection('instruments')).map(({ id, data }) => ({
  id,
  name: data.name,
  beginnerFriendly: data.beginnerFriendly,
  demoStartSeconds: data.demoStartSeconds,
}));
---

<PageLayout
  title="Free Music Lessons in San Leandro"
  description="Free group band lessons for ages 8 to 108 in San Leandro, CA. Woodwinds, brass and percussion. Start any time of year."
  hero
  bare
>
  <Hero image={rehearsal} alt="Students rehearsing with the conductor" size="page" surface="tint">
    <h1>Free Music Lessons</h1>
    <p class="sub">for ages 8 and up, in San Leandro</p>
  </Hero>

  <Surface surface="tint">
    <p class="lead">
      When we say <em>free lessons</em>, we really mean it. Our volunteers and donors make it
      possible to teach every student without charging a cent. From beginners to those with a few
      years of experience, you're welcome to start any time of year. It's always a great time to
      learn, from ages 8 to 108.
    </p>
    <div class="facts">
      <FactRow
        facts={[
          { icon: BadgeDollarSign, label: 'Cost', value: program.cost },
          { icon: Cake, label: 'Ages', value: '8 to 108' },
          {
            icon: Clock,
            label: 'When',
            value: `${s.beginner.day}s`,
            detail: `Beginners ${s.beginner.time}, intermediate ${s.intermediate.time}`,
          },
          {
            icon: DoorOpen,
            label: 'How to start',
            value: 'Just come',
            detail: `${s.beginner.day} at ${s.beginner.time}, ${site.clubhouse.street}. No sign-up needed.`,
          },
        ]}
      />
    </div>
    <ButtonRow>
      <Button href="#getting-ready">Plan your first visit</Button>
      <a href="/contact">Questions? Contact us</a>
    </ButtonRow>
  </Surface>

  <Surface title="How it works">
    <p class="lead">
      Lessons are taught in small groups once a week, for {s.beginner.length}. They're comparable
      to, and a great complement to, many public school music programs.
    </p>
    <div class="steps">
      <StepRow
        steps={[
          {
            title: `Beginner class, ${s.beginner.time}`,
            text: 'Introduces new musicians to their instruments and to reading music.',
          },
          {
            title: `Intermediate class, ${s.intermediate.time}`,
            text: 'More challenging music and music theory. Many band volunteers use it to learn a second or third instrument.',
          },
          {
            title: 'The volunteer band',
            text: 'Many of our musicians started in these classes. Our conductor, Geronimo, joined as a middle school student.',
          },
        ]}
      />
    </div>
  </Surface>

  <TileBand />

  <Surface>
    <MediaFeature
      image={gym}
      alt="The concert band rehearsing with the conductor"
      side="right"
      tone="tint"
    >
      <h2>Your teacher</h2>
      <PeopleList role="teacher" />
    </MediaFeature>
  </Surface>

  <Surface surface="green" pattern="field" width="centered">
    <QuoteBox>
      <div class="stack">
        <h2>What students learn</h2>
        <ul>
          <li>How to play and care for their instrument</li>
          <li>How to read music and keep time</li>
          <li>Common scales, musical keys and notation</li>
          <li>Musical etiquette, and how to practice at home</li>
        </ul>
        <div class="practice">
          <Quote by="Every successful musician, ever!">
            <p>Building a regular practice routine at home is the key to succeeding in music.</p>
          </Quote>
        </div>
      </div>
    </QuoteBox>
  </Surface>

  <Surface title="Choose an instrument">
    <p class="lead">
      Our program is built around concert band and marching music, so we teach woodwinds, brass and
      percussion, but not strings or piano. Tap an instrument to see and hear it. ★ marks the most
      common choices for beginners.
    </p>
    <Todo block>
      the demo video is now private on YouTube: replace it with a public one and update demoVideoId
      in src/content/lessons.yaml (docs/todo.md)
    </Todo>
    <InstrumentPicker client:visible videoId={program.demoVideoId} instruments={instruments} />
  </Surface>

  <Surface surface="tint" title="Getting ready" id="getting-ready" width="narrow">
    <Accordion>
      <details>
        <summary>What you'll need</summary>
        <p>Each beginning student needs their own instrument and method book.</p>
        <Todo block>
          a photo of the method book here, and possibly an Amazon affiliate link (docs/todo.md)
        </Todo>
        <ul>
          <li>
            <strong>Method book:</strong> <cite>{program.methodBook.title}</cite> (the red one).{' '}
            {program.methodBook.note}
          </li>
          {program.accessories.map(({ instruments, items }) => (
            <li>
              <strong>{instruments}:</strong> {items.charAt(0).toLowerCase() + items.slice(1)}
            </li>
          ))}
        </ul>
        <p>
          Each intermediate student needs <cite>{program.intermediateBook.title}</cite> (the{' '}
          {program.intermediateBook.color} one).
        </p>
      </details>
      <details>
        <summary>Where to rent or buy</summary>
        <Todo block>revisit the store list and map (docs/todo.md)</Todo>
        <p>Our musicians have been happy with these local shops:</p>
        <StoreList kind="local" />
        <MapEmbed
          src="https://www.google.com/maps/d/embed?mid=1Rf94gdKG8Bf4opaiKifwnX2ZrOpaziRa"
          title="Map of recommended music stores"
          label="Show the store map"
        />
        <p>
          Popular online shops (we recommend a local store with knowledgeable staff when possible):
        </p>
        <StoreList kind="online" />
      </details>
      <details>
        <summary>Stay in the loop</summary>
        <ul>
          <li>
            <strong>Remind:</strong> lesson updates for students and families.
            <Todo>how to join the lessons Remind list</Todo>
          </li>
          <li>
            <CalendarLink calendar="lessons" />
          </li>
        </ul>
        <h3>Coming up</h3>
        <EventList
          calendar="lessons"
          days={21}
          compact
          level={4}
          empty="No lessons are scheduled in the next three weeks."
        />
      </details>
    </Accordion>
  </Surface>

  <Surface title="FAQ" width="narrow">
    <Accordion>
      <FaqList />
    </Accordion>
  </Surface>

  <Surface surface="tint" pattern="field" width="centered">
    <QuoteBox>
      <div class="stack">
        <h2>Ready to start?</h2>
        <Todo block>
          a quote from a student or family (Home already uses Aubury's; docs/todo.md)
        </Todo>
        <p>
          Come to the next class, {s.beginner.day} at {s.beginner.time}. Questions first?
        </p>
        <ButtonRow>
          <Button href="/contact">Contact us</Button>
        </ButtonRow>
      </div>
    </QuoteBox>
  </Surface>
</PageLayout>

<style>
  @layer components {
    .lead {
      margin-bottom: var(--space-m);
    }

    .facts,
    .steps {
      margin-top: var(--space-l);
    }

    .practice {
      margin-top: var(--space-m);
    }
  }
</style>

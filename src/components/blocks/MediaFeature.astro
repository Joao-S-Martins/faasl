---
// A photo with a content box overlapping it, so the photo looks shaped
// around the text. Desktop: photo on one side, the box floating over its
// edge, all corners rounded. Phones and tablets: photo first, the box butting
// against it, square where they meet.
//   side: left · right (photo side on desktop)
//   tone: plain · tint · green (the box's color)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  side?: 'left' | 'right';
  tone?: 'plain' | 'tint' | 'green';
}

const { image, alt, side = 'left', tone = 'plain' } = Astro.props;
---

<div class:list={['feature', side, tone]}>
  <Image
    src={image}
    alt={alt}
    width={1200}
    widths={[480, 800, 1200]}
    sizes="(width >= 64rem) 45rem, 100vw"
    quality={70}
    class="photo"
  />
  <div class="box stack" data-on={tone === 'green' ? 'dark' : 'light'}>
    <slot />
  </div>
</div>

<style>
  @layer components {
    .feature {
      display: grid;
    }

    .photo {
      width: 100%;
      height: min(26rem, 60svh);
      object-fit: cover;
      border-radius: var(--r-box) var(--r-box) 0 0;
    }

    .box {
      padding: var(--space-m) var(--space-m) var(--space-l);
      border-radius: 0 0 var(--r-box) var(--r-box);
      box-shadow: var(--shadow-soft);
    }

    .box > :global(*) {
      max-width: var(--measure);
    }

    .plain .box {
      background: var(--color-white);
    }

    .tint .box {
      background: var(--color-off-white);
    }

    .green .box {
      background: var(--color-hunter-green);
    }

    @media (width >= 64rem) {
      .feature {
        grid-template-columns: repeat(12, 1fr);
        align-items: center;
      }

      .photo {
        grid-row: 1;
        height: 32rem;
        border-radius: var(--r-box);
      }

      .box {
        grid-row: 1;
        padding: var(--space-l);
        border-radius: var(--r-box);
        box-shadow: var(--shadow-float);
      }

      .left .photo {
        grid-column: 1 / 9;
      }

      .left .box {
        grid-column: 7 / 13;
      }

      .right .photo {
        grid-column: 5 / 13;
      }

      .right .box {
        grid-column: 1 / 7;
      }
    }
  }
</style>

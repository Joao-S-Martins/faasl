---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import FactList from '../components/FactList.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import Testimonial from '../components/Testimonial.astro';
import Actions from '../components/Actions.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { getScheduleMap } from '../lib/schedule';
import { getSite } from '../lib/site';
import growing from '../assets/photos/growing-together.jpg';

const site = await getSite();
const s = await getScheduleMap();
---

<PageLayout
  title="Join the Band"
  description="Join a free community band in San Leandro, CA. Experienced and aspiring musicians welcome, no audition. Concert and marching music, festas, parades and festivals."
>
  <PageHeader
    title="Join the Band"
    subtitle="a community band for experienced and aspiring musicians alike"
    image={growing}
    imageAlt="Musicians of different ages marching and playing together in uniform"
  >
    <p>
      Whether you've played for decades or your instrument's been collecting dust, there's a seat
      for you in our volunteer band. We're a mixed-age group of new and experienced musicians,
      dedicated to improving one another as much as ourselves. Younger musicians play alongside
      older ones, learning in a way that simply can't be replicated in a peer-aged group.
      Experienced musicians take pride in helping the next generation while growing their own skills
      with a challenging and changing repertoire.
    </p>
    <p>
      <strong>Just show up.</strong> There are no auditions and no sign-up. Bring your instrument to
      any rehearsal; we always have extra sheet music ready for you to read.
    </p>
  </PageHeader>

  <Section title="What we play">
    <p>
      We play concert band and marching music, and we perform around the SF Bay and Central Valley
      every year:
    </p>
    <ul>
      <li>
        <strong>Holy Ghost parades:</strong> hosted by Portuguese communities throughout the year
      </li>
      <li>
        <strong>Music festivals:</strong> we host guest bands, or they host us
      </li>
      <li>
        <strong>City events:</strong> the Cherry Festival parade and others
      </li>
      <li>
        <strong>Caroling:</strong> bringing cheer to the holiday season
      </li>
    </ul>
  </Section>

  <Section title="Rehearsals">
    <FactList
      facts={[
        { term: 'When', detail: `${s.band.day}s at ${s.band.time} (right after lessons)` },
        { term: 'How long', detail: `${s.band.length}${s.band.note ? `, ${s.band.note}` : ''}` },
        { term: 'Where', detail: `${site.clubhouse.street}, ${site.clubhouse.city}` },
      ]}
    />
  </Section>

  <Section title="Our conductors">
    <PeopleGrid role="conductor" />
  </Section>

  <Section title="Coming back to music, or starting fresh?">
    <p>
      That instrument in the back of your closet still has music in it. Many of our members returned
      to playing after years away, and the band is a welcoming place to rediscover it. Adults are
      also welcome to start from scratch: our <a href="/lessons">free lessons</a> teach beginners of
      any age, and many band members use the intermediate class to brush up or learn a second
      instrument.
    </p>
    <Testimonial audience="musicians" />
  </Section>

  <Section title="Ready to play?">
    <p>Come to the next rehearsal. Questions first?</p>
    <Actions>
      <ButtonLink href="/contact">Contact us</ButtonLink>
    </Actions>
  </Section>
</PageLayout>

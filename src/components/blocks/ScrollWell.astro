---
// A recessed tray around a sideways-scrolling row. It clips the row with
// rounded corners and draws a rim over it, so cards seem to slide under the
// tray's edge. The rim ignores taps. Light or dark follows the surface.
---

<div class="well">
  <slot />
</div>

<style>
  @layer components {
    .well {
      position: relative;
      overflow: hidden;
      border-radius: var(--r-tray);
      background: var(--color-off-white);
      --row-pad: 1rem;
      --well-rim: var(--color-tray-rim);
      --well-shadow: rgb(0 0 0 / 0.14);
    }

    :global([data-on='dark']) > .well,
    :global([data-on='dark']) .well {
      background: rgb(0 0 0 / 0.22);
      --well-rim: var(--color-hunter-dark);
      --well-shadow: rgb(0 0 0 / 0.45);
    }

    .well::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow:
        inset 0 0 0 8px var(--well-rim),
        inset 0 3px 10px 4px var(--well-shadow);
      pointer-events: none;
    }

    /* cards in the light tray are white, so they stand out from it */
    .well :global(.card) {
      --card-bg: var(--color-white);
    }
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const { name, title, photo, draft } = person.data;
const { Content } = await render(person);
---

<article class:list={['person', { draft }]}>
  {draft && <p class="draft-badge">Draft: details needed</p>}
  {photo ? (
    <Image src={photo} alt={`Portrait of ${name}`} width={160} height={160} class="photo" />
  ) : (
    <div class="photo placeholder" aria-hidden="true" />
  )}
  <h3>{name}</h3>
  <p class="title">{title}</p>
  <div class="bio">
    <Content />
  </div>
</article>

<style>
  .person {
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    padding: var(--space-m);
    background: var(--color-surface);
    border-radius: var(--radius);
    text-align: center;
  }

  .draft {
    outline: 3px dashed var(--color-gold);
  }

  .draft-badge {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
  }

  .placeholder {
    background: var(--color-light-gold);
  }

  .title {
    font-weight: 600;
    color: var(--color-hunter-green);
  }

  .bio {
    font-size: var(--step--1);
  }
</style>

---
import Surface from '../../components/blocks/Surface.astro';
import StatGrid from '../../components/blocks/StatGrid.astro';
import PartyPopper from '@lucide/astro/icons/party-popper';
import Users from '@lucide/astro/icons/users';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Drum from '@lucide/astro/icons/drum';
---

<Surface title="Music in our community" centerTitle>
  <StatGrid
    stats={[
      { icon: PartyPopper, value: '46', label: 'years of music, since 1980' },
      { icon: Users, value: '35+', label: 'musicians in the band' },
      { icon: GraduationCap, value: '20', label: 'students per class each year' },
      { icon: Drum, value: '12', label: 'parades and 6 concerts a year' },
    ]}
  />
</Surface>

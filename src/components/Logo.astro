---
// The lyre logo, inline so it takes the surrounding text color
// (gold on white or green, ink on gold).
import raw from '../assets/logo.svg?raw';

interface Props {
  size?: number;
  /** Accessible name; leave empty when the name is written next to it. */
  label?: string;
}

const { size = 48, label = '' } = Astro.props;
const svg = raw
  .replace(/<title>.*?<\/title>/, '')
  .replace(/fill="#f3dd3e"/gi, 'fill="currentColor"')
  .replace('<svg', `<svg width="${size}" height="${size}" focusable="false"`);
---

<span
  class="logo"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>

<style>
  .logo {
    display: inline-flex;
    line-height: 0;
  }
</style>

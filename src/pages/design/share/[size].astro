---
// The social share image, laid out as a page so it uses the real fonts,
// logo and tiles. Built only outside production. To update public/share.png,
// screenshot this page at exactly 1200×630 (docs/brand.md, Share image).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Logo from '../../../components/patterns/Logo.astro';
import TilePattern from '../../../components/patterns/TilePattern.astro';
import { getSite, isProduction } from '../../../lib/site';

export function getStaticPaths() {
  return isProduction ? [] : [{ params: { size: '1200x630' } }];
}

const site = await getSite();
---

<BaseLayout title="Share image" description="The social share image." noindex>
  <div class="card">
    <div class="tiles">
      <TilePattern variant="checker" tile={96} height="630px" frame={false} center="both" />
    </div>
    <div class="box">
      <Logo size={100} />
      <p class="name">{site.name}</p>
      <p class="official">{site.legalName}</p>
      <p class="tagline">{site.tagline}</p>
    </div>
  </div>
</BaseLayout>

<style>
  @layer components {
    .card {
      position: relative;
      display: grid;
      place-items: center;
      width: 1200px;
      height: 630px;
      overflow: hidden;
    }

    .tiles {
      position: absolute;
      inset: 0;
    }

    /* Six by six tiles, centered on grout lines and inset by half the grout,
       so the gap around the box matches the gap between tiles and no tile is
       cut. Square, so square crops (some messaging apps) keep all of it. The
       gold border sits inside a green margin, apart from the tiles' gold
       corners. */
    .box {
      position: relative;
      display: grid;
      align-content: center;
      justify-items: center;
      gap: 16px;
      width: calc(6 * 96px - 6px);
      height: calc(6 * 96px - 6px);
      padding-inline: 48px;
      background: var(--color-hunter-green);
      color: var(--color-white);
      text-align: center;
    }

    .box::before {
      content: '';
      position: absolute;
      inset: 12px;
      border: 5px solid var(--color-gold);
    }

    .box :global(.logo) {
      color: var(--color-gold);
      margin-bottom: 4px;
    }

    .name {
      font-family: var(--font-heading);
      font-size: 68px;
      font-weight: 700;
      line-height: 1;
    }

    .official {
      font-size: 24px;
      font-weight: 600;
    }

    .tagline {
      padding-top: 14px;
      border-top: 3px solid var(--color-gold);
      font-size: 28px;
      font-style: italic;
    }
  }
</style>

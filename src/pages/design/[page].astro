---
// Design-phase pages, built only for beta and local previews (never in
// production). /design/brand is the brand guide; decisions live in
// docs/brand.md.
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Logo from '../../components/Logo.astro';
import TilePattern from '../../components/TilePattern.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import Actions from '../../components/Actions.astro';
import { contrast } from '../../lib/contrast';
import { getSite, isProduction } from '../../lib/site';

export function getStaticPaths() {
  return isProduction ? [] : [{ params: { page: 'brand' } }];
}

const site = await getSite();

const palette = [
  {
    name: 'Hunter green',
    hex: '#355749',
    role: 'The brand color: buttons, links, headings, dark bands (the jacket and tie)',
  },
  {
    name: 'Gold',
    hex: '#F3DD3E',
    role: 'Only the lyre and small uniform-like accents (thin lines, trim, dots). Never text, buttons or backgrounds.',
  },
  { name: 'White', hex: '#FFFFFF', role: 'Page background (shirts, pants, hats)' },
  { name: 'Off-white', hex: '#F0F0F0', role: 'Surfaces and cards' },
  { name: 'Ink', hex: '#333333', role: 'Body text' },
];

const retired = [
  {
    name: 'FAASL green',
    hex: '#00A079',
    why: 'Not a good representation; hunter green leads instead.',
  },
  { name: 'Light gold', hex: '#FFEB5B', why: 'Gold is reserved for the lyre and accents.' },
];

// Only text pairs at 4.5:1 or better are allowed, at any size; pairs that break
// a brand rule are not allowed whatever their ratio.
const pairs = [
  { fg: '#333333', bg: '#FFFFFF', label: 'Ink on white' },
  { fg: '#333333', bg: '#F0F0F0', label: 'Ink on off-white' },
  { fg: '#355749', bg: '#FFFFFF', label: 'Hunter green on white' },
  { fg: '#355749', bg: '#F0F0F0', label: 'Hunter green on off-white' },
  { fg: '#FFFFFF', bg: '#355749', label: 'White on hunter green' },
  { fg: '#F0F0F0', bg: '#355749', label: 'Off-white on hunter green' },
  { fg: '#F3DD3E', bg: '#355749', label: 'Gold on hunter green', rule: 'gold is never text' },
  { fg: '#333333', bg: '#F3DD3E', label: 'Ink on gold', rule: 'gold is never a background' },
  { fg: '#F3DD3E', bg: '#FFFFFF', label: 'Gold on white', rule: 'unreadable' },
  { fg: '#FFFFFF', bg: '#00A079', label: 'White on FAASL green', rule: 'retired color' },
].map((pair) => {
  const ratio = contrast(pair.fg, pair.bg);
  const allowed = !pair.rule && ratio >= 4.5;
  const verdict = allowed ? 'Allowed' : `Not allowed: ${pair.rule ?? 'below 4.5:1'}`;
  return { ...pair, ratio, allowed, verdict };
});

const fontPairs = [
  {
    id: 'b',
    name: 'B · Marching band (chosen)',
    heading: "'Barlow Condensed', 'Arial Narrow', sans-serif",
    headingWeight: 700,
    body: "'Barlow', system-ui, sans-serif",
    note: 'Barlow Condensed headings with Barlow text. Uniform-like, energetic and modern.',
  },
];

const taglines = [
  { text: site.tagline, source: 'Main line for now (pending the board)' },
  {
    text: "We're committed to impacting lives through music education and mentorship.",
    source: 'Alternative: previous tagline',
  },
  {
    text: 'Dedicated to bringing free music education and public performance opportunities to the greater East Bay.',
    source: 'Alternative: from the 2018 brochure',
  },
  {
    text: 'Free music lessons and live music for our community, since 1980.',
    source: 'Alternative',
  },
];
---

<PageLayout title="Brand guide" description="Beta-only brand guide for the v3 site." noindex>
  <PageHeader title="Brand guide" subtitle="beta only: for choosing the look of v3">
    <p>
      Names, logo, colors, fonts, taglines and patterns, shown in place so they can be judged on a
      phone. Decisions are recorded in <code>docs/brand.md</code>.
    </p>
  </PageHeader>

  <Section title="Names">
    <p class="name-lead">{site.name}</p>
    <p class="name-official">{site.legalName}</p>
    <p>
      The English name leads; the official name, with its accent, appears beneath it or in the
      footer. The members' shorthand, {site.alternateName}, stays off public headings.
    </p>
  </Section>

  <Section title="Logo lockups">
    <div class="lockups">
      <div class="lockup on-white">
        <Logo size={64} />
        <div>
          <p class="lockup-name">{site.name}</p>
          <p class="lockup-official">{site.legalName}</p>
        </div>
      </div>
      <div class="lockup on-hunter">
        <Logo size={64} />
        <div>
          <p class="lockup-name">{site.name}</p>
          <p class="lockup-official">{site.legalName}</p>
        </div>
      </div>
      <div class="lockup stacked on-white">
        <Logo size={96} />
        <p class="lockup-name">{site.name}</p>
      </div>
    </div>
    <p class="note">
      The gold lyre on white or hunter green. Gold appears only in the lyre and small accents. The
      uniform crest joins these once a vector exists.
    </p>
  </Section>

  <Section title="Colors">
    <ul class="swatches">
      {palette.map(({ name, hex, role }) => (
        <li>
          <span class="chip" style={`background:${hex}`} />
          <span>
            <strong>{name}</strong> <code>{hex}</code>
            <br />
            <span class="note">{role}</span>
          </span>
        </li>
      ))}
    </ul>
    <h3>Retired</h3>
    <ul class="swatches retired">
      {retired.map(({ name, hex, why }) => (
        <li>
          <span class="chip" style={`background:${hex}`} />
          <span>
            <s>
              <strong>{name}</strong> <code>{hex}</code>
            </s>
            <br />
            <span class="note">{why}</span>
          </span>
        </li>
      ))}
    </ul>
    <h3>The uniform</h3>
    <div
      class="uniform"
      aria-label="Uniform colors: green jacket and tie, white shirt, pants and hat, gold lyre"
    >
      <span style="background:#355749">Jacket &amp; tie</span>
      <span style="background:#FFFFFF;color:#333">Shirt, pants, hat</span>
      <span style="background:#F3DD3E;color:#333">Lyre</span>
    </div>
    <p class="note">Hunter green to be checked against a daylight photo of a jacket.</p>
  </Section>

  <Section title="Text and background pairs">
    <p>
      Rule: text may only use <strong>allowed</strong> pairs, which meet WCAG 2.2 AA at 4.5:1 or
      better at any size. Ratios use the WCAG formula, which measures brightness, not how vivid a
      color looks. Anything else is not allowed, even where WCAG would permit large text.
    </p>
    <ul class="pairs">
      {pairs.map(({ fg, bg, label, ratio, allowed, verdict }) => (
        <li class:list={{ blocked: !allowed }}>
          <span class="sample" style={`color:${fg};background:${bg}`}>
            {label}
          </span>
          <span class="verdict">
            {allowed ? '✓' : '✗'} {verdict} · {ratio}:1
          </span>
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Buttons and links">
    <Actions>
      <ButtonLink href="#">Join the band</ButtonLink>
      <ButtonLink href="#" variant="secondary">
        Our story
      </ButtonLink>
      <a class="donate-sample" href="#">
        Donate
      </a>
      <a href="#">A text link</a>
    </Actions>
    <p class="accent-rule">A gold accent line, like uniform trim</p>
  </Section>

  <Section title="Fonts">
    {fontPairs.map(({ id, name, heading, headingWeight, body, note }) => (
      <article
        class="font-pair"
        id={`fonts-${id}`}
        style={`--heading:${heading};--heading-weight:${headingWeight};--body:${body}`}
      >
        <p class="pair-name">{name}</p>
        <p class="pair-h1">We've built a community around music</p>
        <p class="pair-h2">Free music lessons for ages 8 to 108</p>
        <p class="pair-body">
          Our band was founded in 1980 by amateur musicians, mostly Portuguese immigrants, who
          wanted to enrich their community through music. Today we're a diverse, all-volunteer group
          of musicians of every age and background.
        </p>
        <p class="pair-body pair-accents">
          Filarmónica Artista Amadora · sopas · linguiça · malassadas
        </p>
        <p class="note">{note}</p>
      </article>
    ))}
  </Section>

  <Section title="Tagline options">
    <ol class="taglines">
      {taglines.map(({ text, source }) => (
        <li>
          <p class="tagline">{text}</p>
          <p class="note">{source}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section title="Musical tile patterns">
    <p>
      Hand-painted tiles are traditionally blue on white. These borrow the idea with musical motifs
      (staff lines, notes, a sharp, a fermata) in hunter green on white, with gold only as a small
      accent. Decorative only.
    </p>
    <h3>Rosette of notes ✅ chosen</h3>
    <p>
      Beamed eighth notes turned four times around a gold ring, on a square tile with a margin like
      grout. Each corner carries a quarter ring and a gold quarter circle, so four tiles suggest one
      ring across the grout, as on a tiled wall. Nothing is drawn in the grout.
    </p>
    <TilePattern variant="rosette" height="18rem" />

    <h3>Staff tile, for horizontal bands</h3>
    <p>
      A half note, two beamed eighth notes and a quarter note on a staff, built like the rosette
      (same face, grout and corners) so the two sit together. Used one tile high, as a band.
    </p>

    <h4>Under a page header</h4>
    <div class="example">
      <div class="mock-header">
        <p class="mock-kicker">Lessons</p>
        <p class="mock-title">Free music lessons in San Leandro</p>
      </div>
      <TilePattern variant="staff" tile={48} height="48px" frame={false} />
    </div>

    <h4>Between sections</h4>
    <div class="example mock-page">
      <p>…the end of one section, with its call to action.</p>
      <TilePattern variant="staff" tile={40} height="40px" frame={false} />
      <p>The next section starts here.</p>
    </div>

    <h4>A tile panel: staff border around rosettes</h4>
    <p class="note">
      The classic layout of a Portuguese tile panel: a border row framing a field of patterned
      tiles. For a heritage section or the About page.
    </p>
    <div class="example panel">
      <TilePattern variant="staff" tile={64} height="64px" frame={false} />
      <TilePattern variant="rosette" tile={64} height="128px" frame={false} />
      <TilePattern variant="staff" tile={64} height="64px" frame={false} />
    </div>

    <h4>Above the footer</h4>
    <div class="example">
      <TilePattern variant="staff" tile={32} height="32px" frame={false} />
      <div class="mock-footer">
        Portuguese Band of San Leandro · Where generations play together.
      </div>
    </div>

    <h3>Subtle staff, for section breaks and backgrounds</h3>
    <p>
      One long, faint staff with a few notes. Quiet enough to sit behind text; it never carries
      meaning, so it stays decorative. On green it's drawn in white.
    </p>
    <TilePattern variant="subtle" height="4rem" />

    <h4>Section break: one staff between sections</h4>
    <div class="example mock-page">
      <p>…the end of one section, with its call to action.</p>
      <TilePattern variant="subtle" height="48px" frame={false} />
      <p>The next section starts here.</p>
    </div>

    <h4>Page header background</h4>
    <div class="example on-staff mock-header">
      <div class="staff-bg">
        <TilePattern
          variant="subtle"
          ink="var(--color-white)"
          ground="var(--color-hunter-green)"
          height="100%"
          frame={false}
        />
      </div>
      <p class="mock-kicker">Join the band</p>
      <p class="mock-title">Experienced and aspiring musicians alike</p>
    </div>

    <h4>Call to action block</h4>
    <div class="example on-staff mock-cta">
      <div class="staff-bg">
        <TilePattern variant="subtle" ground="var(--color-off-white)" height="100%" frame={false} />
      </div>
      <p class="mock-title">Keep music lessons free</p>
      <p>Your gift buys method books, repairs instruments and keeps the band playing.</p>
      <ButtonLink href="#">Donate</ButtonLink>
    </div>

    <h4>Behind a testimonial snippet</h4>
    <div class="example on-staff mock-quote">
      <div class="staff-bg">
        <TilePattern variant="subtle" height="100%" frame={false} />
      </div>
      <blockquote>
        <p>“A pull quote from a member story goes here, one or two sentences long.”</p>
        <footer>Member name, instrument</footer>
      </blockquote>
    </div>

    <h4>Numbers strip</h4>
    <div class="example on-staff mock-numbers">
      <div class="staff-bg">
        <TilePattern
          variant="subtle"
          ink="var(--color-white)"
          ground="var(--color-hunter-green)"
          height="100%"
          frame={false}
        />
      </div>
      <ul>
        <li>
          <strong>35+</strong> musicians
        </li>
        <li>
          <strong>12</strong> parades a year
        </li>
        <li>
          <strong>6</strong> concerts a year
        </li>
      </ul>
    </div>

    <h4>Footer background</h4>
    <div class="example on-staff mock-footer">
      <div class="staff-bg">
        <TilePattern
          variant="subtle"
          ink="var(--color-white)"
          ground="var(--color-hunter-green)"
          height="100%"
          frame={false}
        />
      </div>
      <p>Portuguese Band of San Leandro · Where generations play together.</p>
    </div>
  </Section>
</PageLayout>

<style>
  .example {
    margin-block: var(--space-s) var(--space-m);
    border: 1px solid #ddd;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .mock-page {
    padding-block: var(--space-s);
  }

  .mock-page p {
    margin: var(--space-s) var(--space-m);
  }

  .mock-header {
    padding: var(--space-m);
    background: var(--color-hunter-green);
    color: var(--color-white);
  }

  .mock-kicker {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mock-title {
    font-family: var(--font-heading);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.1;
  }

  .mock-footer {
    padding: var(--space-m);
    background: var(--color-hunter-green);
    color: var(--color-white);
    font-size: var(--step--1);
  }

  /* the staff sits behind the block's content */
  .on-staff {
    position: relative;
    isolation: isolate;
  }

  .staff-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .mock-cta,
  .mock-quote {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    padding: var(--space-l) var(--space-m);
  }

  .mock-cta .mock-title {
    color: var(--color-hunter-green);
  }

  .mock-quote blockquote {
    margin: 0;
    font-size: var(--step-1);
    font-style: italic;
  }

  .mock-quote footer {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    font-style: normal;
    font-weight: 600;
  }

  .mock-numbers {
    padding: var(--space-m);
    color: var(--color-white);
  }

  .mock-numbers ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .mock-numbers strong {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--step-3);
  }

  .panel {
    border: 0;
    border-radius: 0;
  }

  .name-lead {
    font-family: var(--font-heading);
    font-size: var(--step-3);
    color: var(--color-hunter-green);
    line-height: 1.1;
  }

  .name-official {
    font-size: var(--step-1);
    font-style: italic;
  }

  .lockups {
    display: grid;
    gap: var(--space-s);
  }

  .lockup {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-m);
    border-radius: var(--radius);
    border: 1px solid #ddd;
  }

  .lockup.stacked {
    flex-direction: column;
    text-align: center;
  }

  .lockup-name {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.15;
  }

  .lockup-official {
    font-size: var(--step--1);
    font-style: italic;
  }

  .on-white {
    background: #fff;
    color: #355749;
  }

  .on-white :global(.logo) {
    color: #f3dd3e;
  }

  .on-hunter {
    background: #355749;
    color: #fff;
  }

  .on-hunter :global(.logo) {
    color: #f3dd3e;
  }

  .swatches {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: flex;
    gap: var(--space-s);
    align-items: center;
  }

  .chip {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    border: 1px solid #ccc;
  }

  .uniform {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr;
    border: 1px solid #ccc;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .uniform span {
    padding: var(--space-s);
    color: #fff;
    font-weight: 700;
    font-size: var(--step--1);
  }

  .pairs {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .pairs li {
    display: grid;
    gap: 0.25rem;
  }

  .sample {
    padding: var(--space-s);
    border: 1px solid #ddd;
    border-radius: var(--radius);
    font-weight: 700;
  }

  .verdict {
    font-size: var(--step--1);
  }

  .blocked .sample {
    text-decoration: line-through;
  }

  .blocked .verdict {
    color: #a12;
    font-weight: 700;
  }

  .retired .chip {
    opacity: 0.5;
  }

  .accent-rule {
    padding-bottom: var(--space-xs);
    border-bottom: 3px solid var(--color-gold);
  }

  .donate-sample {
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius);
    background: var(--color-hunter-green);
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .font-pair {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-m);
    border: 1px solid #ddd;
    border-radius: var(--radius);
    font-family: var(--body);
  }

  .pair-name {
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pair-h1 {
    font-family: var(--heading);
    font-size: var(--step-3);
    font-weight: var(--heading-weight);
    line-height: 1.1;
    color: var(--color-hunter-green);
  }

  .pair-h2 {
    font-family: var(--heading);
    font-size: var(--step-2);
    font-weight: var(--heading-weight);
    line-height: 1.15;
    color: var(--color-hunter-green);
  }

  .pair-accents {
    font-style: italic;
  }

  .taglines {
    display: grid;
    gap: var(--space-m);
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    color: var(--color-hunter-green);
  }

  .note {
    font-size: var(--step--1);
    color: #555;
  }
</style>

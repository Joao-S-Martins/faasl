---
// The Lessons page in each design direction (docs/brief.md §3.1). Same copy
// as the current Lessons page; long lists collapse into accordions.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BadgeDollarSign from '@lucide/astro/icons/badge-dollar-sign';
import Cake from '@lucide/astro/icons/cake';
import Clock from '@lucide/astro/icons/clock';
import MapPin from '@lucide/astro/icons/map-pin';
import Band from './Band.astro';
import Feature from './Feature.astro';
import TilePattern from '../TilePattern.astro';
import ButtonLink from '../ButtonLink.astro';
import Actions from '../Actions.astro';
import PeopleGrid from '../PeopleGrid.astro';
import InstrumentPicker from '../InstrumentPicker';
import StoreList from '../StoreList.astro';
import CalendarLink from '../CalendarLink.astro';
import FaqList from '../FaqList.astro';
import Testimonial from '../Testimonial.astro';
import Todo from '../Todo.astro';
import { getScheduleMap } from '../../lib/schedule';
import { getSite } from '../../lib/site';
import rehearsal from '../../assets/photos/students-rehearsal.jpg';
import gym from '../../assets/photos/concert-band-gym.jpg';

interface Props {
  direction: 'a' | 'b';
}

const { direction: d } = Astro.props;
const site = await getSite();
const s = await getScheduleMap();
const program = (await getEntry('lessons', 'program'))!.data;
const instruments = (await getCollection('instruments')).map(({ id, data }) => ({
  id,
  name: data.name,
  beginnerFriendly: data.beginnerFriendly,
  demoStartSeconds: data.demoStartSeconds,
}));

const facts = [
  { icon: BadgeDollarSign, term: 'Cost', detail: program.cost },
  { icon: Cake, term: 'Ages', detail: '8 to 108' },
  {
    icon: Clock,
    term: `${s.beginner.day}s`,
    detail: `Beginners ${s.beginner.time}, intermediate ${s.intermediate.time}`,
  },
  { icon: MapPin, term: 'Where', detail: `${site.clubhouse.street}, ${site.clubhouse.city}` },
];

const steps = [
  {
    title: `Beginner class, ${s.beginner.time}`,
    text: 'Introduces new musicians to their instruments and to reading music.',
  },
  {
    title: `Intermediate class, ${s.intermediate.time}`,
    text: 'More challenging music and music theory. Many band volunteers use it to learn a second or third instrument.',
  },
  {
    title: 'The band',
    text: 'Many of our musicians started in these classes. Our conductor, Geronimo, joined as a middle school student.',
  },
];
---

<section class:list={['top', d]} data-landing>
  <Image
    src={rehearsal}
    alt="Students rehearsing with the conductor"
    width={1600}
    widths={[640, 1000, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="top-photo"
  />
  <div class="top-text">
    <h1>Free Music Lessons</h1>
    <p class="sub">for ages 8 and up, in San Leandro</p>
  </div>
</section>

<Band bg={d === 'a' ? 'white' : 'tint'}>
  <div class="intro">
    <p class="lead">
      When we say <em>free lessons</em>, we really mean it. Our volunteers and donors make it
      possible to teach every student without charging a cent. From beginners to those with a few
      years of experience, you're welcome to start any time of year. It's always a great time to
      learn, from ages 8 to 108.
    </p>
    <ul class="facts">
      {facts.map(({ icon: Icon, term, detail }) => (
        <li>
          <Icon size={40} stroke-width={1.5} aria-hidden="true" />
          <strong>{term}</strong>
          <span>{detail}</span>
        </li>
      ))}
    </ul>
    <p class="callout">
      <strong>No sign-up needed: just come to a class on {s.beginner.day}s.</strong> Questions
      first? <a href="/contact">Contact us</a>
    </p>
  </div>
</Band>

<Band bg={d === 'a' ? 'tint' : 'white'}>
  <h2>How it works</h2>
  <p class="lead">
    Lessons are taught in small groups once a week, for {s.beginner.length}. They're comparable to,
    and a great complement to, many public school music programs.
  </p>
  <ol class="steps">
    {steps.map(({ title, text }, i) => (
      <li>
        <span class="n" aria-hidden="true">
          {i + 1}
        </span>
        <h3>{title}</h3>
        <p>{text}</p>
      </li>
    ))}
  </ol>
</Band>

{d === 'a' && <TilePattern variant="staff" tile={64} height="64px" frame={false} center="x" />}

<Band>
  <Feature
    image={gym}
    alt="The concert band rehearsing with the conductor"
    side="right"
    tone={d === 'a' ? 'tint' : 'green'}
  >
    <h2>Your teacher</h2>
    <PeopleGrid role="teacher" />
  </Feature>
</Band>

<Band bg={d === 'a' ? 'field' : 'field-green'} narrow>
  <div class="learn-box">
    <h2>What students learn</h2>
    <ul>
      <li>How to play and care for their instrument</li>
      <li>How to read music and keep time</li>
      <li>Common scales, musical keys and notation</li>
      <li>Musical etiquette, and how to practice at home</li>
    </ul>
    <figure>
      <blockquote>
        <p>Building a regular practice routine at home is the key to succeeding in music.</p>
      </blockquote>
      <figcaption>— Every successful musician, ever!</figcaption>
    </figure>
  </div>
</Band>

<Band>
  <h2>Choose an instrument</h2>
  <p class="lead">
    Our program is built around concert band and marching music, so we teach woodwinds, brass and
    percussion, but not strings or piano. Tap an instrument to see and hear it. ★ marks the most
    common choices for beginners.
  </p>
  <InstrumentPicker client:visible videoId={program.demoVideoId} instruments={instruments} />
</Band>

<Band bg="tint" narrow>
  <h2>Getting ready</h2>
  <div class="accordion">
    <details>
      <summary>What you'll need</summary>
      <p>Each student needs their own instrument and method book.</p>
      <ul>
        <li>
          <strong>Method book:</strong> <cite>{program.methodBook.title}</cite> (the red one).{' '}
          {program.methodBook.note}
        </li>
        {program.accessories.map(({ instruments, items }) => (
          <li>
            <strong>{instruments}:</strong> {items.charAt(0).toLowerCase() + items.slice(1)}
          </li>
        ))}
      </ul>
    </details>
    <details>
      <summary>Where to rent or buy</summary>
      <p>Our musicians have been happy with these local shops:</p>
      <StoreList kind="local" />
      <p>
        Popular online shops (we recommend a local store with knowledgeable staff when possible):
      </p>
      <StoreList kind="online" />
    </details>
    <details>
      <summary>Stay in the loop</summary>
      <ul>
        <li>
          <strong>Remind:</strong> lesson updates for students and families.
          <Todo>how to join the lessons Remind list</Todo>
        </li>
        <li>
          <CalendarLink calendar="lessons" />
        </li>
      </ul>
    </details>
  </div>
</Band>

<Band narrow>
  <h2>FAQ</h2>
  <div class="accordion">
    <FaqList />
  </div>
</Band>

<Band bg={d === 'a' ? 'tint' : 'green'} narrow>
  <div class:list={['ready', d]}>
    <h2>Ready to start?</h2>
    <Testimonial audience="students" />
    <p>Come to the next class. Questions first?</p>
    <Actions>
      {d === 'a' ? (
        <ButtonLink href="/contact">Contact us</ButtonLink>
      ) : (
        <a class="button-light" href="/contact">
          Contact us
        </a>
      )}
    </Actions>
  </div>
</Band>

<style>
  .top {
    position: relative;
    display: grid;
  }

  .top-photo {
    width: 100%;
    object-fit: cover;
  }

  .top.a {
    padding-top: 6rem;
  }

  .top.a .top-photo {
    height: clamp(12rem, 40svh, 24rem);
  }

  .top.a .top-text {
    position: relative;
    width: min(100% - 2 * var(--gutter), 34rem);
    margin: -3rem auto 0;
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .top.b {
    min-height: max(22rem, min(60svh, 36rem));
    color: var(--color-white);
  }

  .top.b .top-photo {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .top.b::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 30%, rgb(0 0 0 / 0.7));
  }

  .top.b .top-text {
    position: relative;
    z-index: 1;
    align-self: end;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: 6rem var(--gutter) var(--space-l);
  }

  .top.b h1 {
    color: inherit;
  }

  .sub {
    font-size: var(--step-1);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .top.a .top-text {
      margin: -5rem 0 0 max(var(--gutter), (100% - var(--content-width)) / 2 + var(--gutter));
      padding: var(--space-l);
    }
  }

  .lead {
    max-width: 44rem;
    margin-bottom: var(--space-m);
    font-size: var(--step-1);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
    margin: 0 0 var(--space-m);
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    gap: 0.25rem;
    color: var(--color-ink);
  }

  .facts :global(svg) {
    color: var(--color-hunter-green);
  }

  .facts strong {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    color: var(--color-hunter-green);
    line-height: 1;
  }

  .callout {
    padding: var(--space-s) var(--space-m);
    border-left: 4px solid var(--color-gold);
    background: var(--color-off-white);
  }

  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* The pathway: three boxes that butt together, sharp where they meet */
  .steps {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    padding: var(--space-m);
    background: var(--color-white);
  }

  .steps li:first-child {
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .steps li:last-child {
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--color-hunter-green);
    color: var(--color-white);
  }

  .steps li:last-child h3 {
    color: inherit;
  }

  .n {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: var(--space-xs);
    border-radius: 50%;
    border: 2px solid currentColor;
    font-weight: 700;
  }

  .steps h3 {
    margin-bottom: var(--space-xs);
  }

  .b .steps li {
    background: var(--color-off-white);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }

    .steps li:first-child {
      border-radius: var(--radius) 0 0 var(--radius);
    }

    .steps li:last-child {
      border-radius: 0 var(--radius) var(--radius) 0;
    }
  }

  .learn-box {
    padding: var(--space-l);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
  }

  .learn-box h2 {
    color: var(--color-hunter-green);
  }

  .learn-box > * + * {
    margin-top: var(--space-s);
  }

  .learn-box figure {
    margin: var(--space-m) 0 0;
    font-size: var(--step-1);
    font-style: italic;
  }

  .accordion :global(details) {
    border-bottom: 1px solid #ccc;
  }

  .accordion :global(summary) {
    padding: var(--space-s) 0;
    font-weight: 700;
    font-size: var(--step-1);
    cursor: pointer;
  }

  .accordion :global(details > :not(summary)) {
    margin-bottom: var(--space-s);
  }

  .ready > * + * {
    margin-top: var(--space-s);
  }

  .ready.b :global(.testimonial) {
    border-color: var(--color-gold);
  }

  .button-light {
    display: inline-block;
    padding: 0.625rem 1.125rem;
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-hunter-green) !important;
    font-weight: 700;
    text-decoration: none;
  }
</style>

---
// A photo with a content box that overlaps it, so the photo looks shaped
// around the text (docs/brief.md §3.1). Desktop: photo on one side, the box
// floating over its edge, all corners rounded. Phone: photo full width, the
// box butting against it, with sharp corners where they meet.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  side?: 'left' | 'right';
  /** Box color. */
  tone?: 'white' | 'green' | 'tint';
}

const { image, alt, side = 'left', tone = 'white' } = Astro.props;
---

<div class:list={['feature', side, tone]}>
  <Image
    src={image}
    alt={alt}
    width={1200}
    widths={[480, 800, 1200]}
    sizes="(min-width: 64rem) 60vw, 100vw"
    class="photo"
  />
  <div class="box">
    <slot />
  </div>
</div>

<style>
  .feature {
    display: grid;
  }

  .photo {
    width: 100%;
    height: 100%;
    max-height: 26rem;
    object-fit: cover;
  }

  .box {
    position: relative;
    padding: var(--space-m) var(--gutter) var(--space-l);
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--color-white);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
  }

  .green .box {
    background: var(--color-hunter-green);
    color: var(--color-white);
  }

  .green .box :global(h2),
  .green .box :global(h3),
  .green .box :global(a) {
    color: inherit;
  }

  .tint .box {
    background: var(--color-off-white);
  }

  .box :global(> * + *) {
    margin-top: var(--space-s);
  }

  @media (min-width: 48rem) {
    .feature {
      grid-template-columns: repeat(12, 1fr);
      align-items: center;
    }

    .photo {
      grid-row: 1;
      max-height: 32rem;
      border-radius: var(--radius);
    }

    .box {
      grid-row: 1;
      padding: var(--space-l);
      border-radius: var(--radius);
    }

    .left .photo {
      grid-column: 1 / 9;
    }

    .left .box {
      grid-column: 7 / 13;
    }

    .right .photo {
      grid-column: 5 / 13;
    }

    .right .box {
      grid-column: 1 / 7;
    }
  }
</style>

---
// Upcoming events from one calendar (src/content/events.json, refreshed
// weekly). No Event search data on lists: Google only supports it on pages
// about a single event (see docs/brief.md, SEO guardrails).
import { getCollection, getEntry } from 'astro:content';
import { formatEventWhen } from '../lib/format';
import { eventHref } from '../lib/events';
import Todo from './Todo.astro';

interface Props {
  calendar: 'lessons' | 'performances' | 'social';
  /** Show at most this many (default: all). */
  limit?: number;
  /** Only events starting within this many days. */
  days?: number;
  /** Date, time and title only (no location or description). */
  compact?: boolean;
  /** Shown when there's nothing coming up. */
  empty: string;
  /** Heading level for event titles. */
  level?: 3 | 4;
}

const { calendar, limit, days, empty, level = 3, compact = false } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const now = new Date().toISOString().slice(0, 10);
const events = (await getCollection('events', ({ data }) => data.calendar.id === calendar))
  .filter(({ data }) => data.end.slice(0, 10) >= now)
  .filter(({ data }) => !days || new Date(data.start).getTime() < Date.now() + days * 864e5)
  .sort((a, b) => a.data.start.localeCompare(b.data.start))
  .slice(0, limit);
const calendarEntry = await getEntry('calendars', calendar);
const hasSamples = events.some(({ data }) => data.sample);
---

{hasSamples && (
  <Todo block>
    these are sample events from scripts/fixtures, not the real {calendarEntry?.data.name} calendar
  </Todo>
)}
{events.length ? (
  <ol class="events">
    {events.map(({ data }) => (
      <li>
        <article>
          <Heading>
            {eventHref(data) ? <a href={eventHref(data)}>{data.title}</a> : data.title}
          </Heading>
          {data.tentative && (
            <p class="tentative">
              <strong>Tentative:</strong> date expected, times to be confirmed
            </p>
          )}
          <p class="when">
            <time datetime={data.start}>{formatEventWhen(data)}</time>
          </p>
          {!compact && data.location && <p class="where">{data.location}</p>}
          {!compact && data.description && <p class="description">{data.description}</p>}
        </article>
      </li>
    ))}
  </ol>
) : (
  <p>{empty}</p>
)}

<style>
  .events {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .when {
    font-weight: 700;
  }

  .tentative {
    font-style: italic;
  }

  .description {
    white-space: pre-line;
  }
</style>

---
import PageLayout from '../layouts/PageLayout.astro';
import Surface from '../components/blocks/Surface.astro';
---

<PageLayout title="Page not found" description="This page doesn't exist." noindex bare>
  <Surface surface="tint">
    <div class="stack measure">
      <h1>Page not found</h1>
      <p>Sorry, we couldn't find that page. Try one of these:</p>
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/lessons">Free music lessons</a>
        </li>
        <li>
          <a href="/contact">Contact us</a>
        </li>
        <li>
          Looking for an event? It may have already passed: see{' '}
          <a href="/events">upcoming events</a>
        </li>
      </ul>
    </div>
  </Surface>
</PageLayout>

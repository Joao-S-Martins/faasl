---
// A quotation with the thin gold bar at its left, the treatment every quote
// on the site gets (member stories, sayings).
interface Props {
  /** Who said it; shown after a dash. */
  by: string;
}

const { by } = Astro.props;
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  <figcaption>— {by}</figcaption>
</figure>

<style>
  @layer components {
    .quote {
      margin: 0;
      padding-left: var(--space-s);
      border-left: 4px solid var(--color-accent);
    }

    blockquote {
      margin: 0;
      font-size: var(--step-1);
    }

    figcaption {
      margin-top: var(--space-xs);
      font-size: var(--step--1);
      font-weight: 600;
    }
  }
</style>

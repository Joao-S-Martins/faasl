---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import Surface from '../components/blocks/Surface.astro';
import Columns from '../components/blocks/Columns.astro';
import MediaFeature from '../components/blocks/MediaFeature.astro';
import young from '../assets/photos/young-members.jpg';
import ButtonRow from '../components/blocks/ButtonRow.astro';
import Button from '../components/blocks/Button.astro';
import EventList from '../components/content/EventList.astro';
import CalendarLink from '../components/content/CalendarLink.astro';
import Testimonial from '../components/content/Testimonial.astro';
import Todo from '../components/layout/Todo.astro';
import LinkMore from '../components/blocks/LinkMore.astro';
import HandHeart from '@lucide/astro/icons/hand-heart';
import Ticket from '@lucide/astro/icons/ticket';
import HeartHandshake from '@lucide/astro/icons/heart-handshake';
import Share2 from '@lucide/astro/icons/share-2';
import { getSite, isProduction } from '../lib/site';

const site = await getSite();
// TODO: prices (docs/todo.md). Items without a price are hidden in production.
// Test amounts for now (owner, Oct 2026); review in docs/todo.md. Shown
// highest first.
const gifts: { price?: number; does: string }[] = [
  { price: 500, does: 'outfits a musician in our uniform' },
  { price: 250, does: 'covers a typical instrument repair' },
  { price: 150, does: 'feeds the band dinner after rehearsal' },
  { price: 100, does: 'buys sheet music for a new piece for the whole band' },
  { price: 50, does: 'supports the carpools that get our musicians to performances' },
].sort((a, b) => (b.price ?? 0) - (a.price ?? 0));
const shownGifts = gifts.filter((gift) => gift.price || !isProduction);

const ways = [
  {
    icon: HandHeart,
    title: 'Donate an instrument',
    text: "Have one you no longer play? We'd love to put it back to work.",
    href: '/contact',
    link: 'Tell us about it',
  },
  {
    icon: Ticket,
    title: 'Come hear us play',
    text: 'Parades, festivals, concerts and dinners all year round.',
    href: '/events',
    link: "See what's coming up",
  },
  {
    icon: HeartHandshake,
    title: 'Volunteer',
    text: 'Share your time and skills, on stage or behind the scenes.',
    href: '/about#get-involved',
    link: 'Get involved',
  },
  {
    icon: Share2,
    title: 'Spread the word',
    text: 'Follow us and share our events with your friends.',
    href: '/contact#follow-us',
    link: 'Follow us',
  },
];
---

<PageLayout
  title="Support Free Music Education in San Leandro"
  description="Donate to the Portuguese Band of San Leandro, a 501(c)(3) nonprofit offering free music lessons and free community performances since 1980. Gifts are tax-deductible."
  hero
  bare
>
  <Hero
    size="page"
    surface="tint"
    needs="a fundraiser dinner, or the band performing for the community (warm, people smiling)"
  >
    <h1>Support the Band</h1>
    <p class="sub">keep music free for our community</p>
  </Hero>

  <Surface surface="tint">
    <div class="stack measure">
      <p>
        Since {site.foundingYear}, every lesson we teach has been free. Kids and adults learn an
        instrument at no cost, young musicians are mentored by experienced ones, and our volunteer
        band brings live music to parades, festivals and community events across the Bay Area. All
        of it runs on volunteers and on the generosity of people like you.
      </p>
      <ButtonRow>
        <Todo>Donate button (online giving provider not chosen yet)</Todo>
      </ButtonRow>
    </div>
  </Surface>

  {shownGifts.length > 0 && (
    <Surface>
      <MediaFeature image={young} alt="Two young band members in uniform, smiling" side="right">
        <h2 id="what-your-gift-does">What your gift does</h2>
        <Todo block>test amounts: review the gift amounts (docs/todo.md)</Todo>
        <ul class="gifts">
          {shownGifts.map((gift) => (
            <li>
              <strong>{gift.price ? `$${gift.price}` : <Todo>price</Todo>}</strong>
              <span>{gift.does}</span>
            </li>
          ))}
        </ul>
      </MediaFeature>
    </Surface>
  )}

  <Surface surface="tint">
    <Columns>
      <div class="stack">
        <h2 id="become-a-member">Become a member</h2>
        <p>
          Join the band's family as a supporting member with an annual membership fee. Members keep
          our lessons free year after year.
        </p>
        <Todo block>
          annual amount and what members receive (a full Members page comes in v3.1)
        </Todo>
      </div>
      <div class="stack">
        <h2 id="give-in-someones-name">Give in someone's name</h2>
        <p>
          Honor a loved one, a teacher or a fellow musician with a gift in their name, or remember
          someone who shared our love of music. Just let us know who your gift honors.
        </p>
        <Todo block>how (a field in the donation form, or contact us)</Todo>
      </div>
    </Columns>
  </Surface>

  <Surface title="Join us at a fundraiser dinner">
    <div class="stack">
      <p>
        Throughout the year we host dinners that bring classic Portuguese meals to the table, along
        with some American staples. Every ticket supports our free music programs. Tickets are
        available at the door or from any board member.
      </p>
      <EventList
        calendar="social"
        limit={3}
        empty="No fundraisers are scheduled right now. Add our social calendar to yours to hear about the next one."
      />
      <p>
        <CalendarLink calendar="social" />
      </p>
    </div>
  </Surface>

  <Surface title="Other ways to help" surface="tint" centerTitle>
    <ul class="ways">
      {ways.map(({ icon: Icon, title, text, href, link }) => (
        <li>
          <Icon size={36} stroke-width={1.5} aria-hidden="true" />
          <h3>{title}</h3>
          <p>{text}</p>
          <LinkMore href={href}>{link}</LinkMore>
        </li>
      ))}
    </ul>
  </Surface>

  <Surface>
    <Columns align="center">
      <div class="stack">
        <h2 id="for-businesses">For businesses</h2>
        <p>
          Many employers match their employees' charitable gifts, often doubling them. Ask your HR
          or giving program whether we qualify. Our registered name is the{' '}
          <strong>{site.legalName}</strong>, a 501(c)(3) nonprofit (EIN {site.ein}), classified as{' '}
          {site.classification}. Interested in supporting us as a business?
        </p>
        <ButtonRow>
          <Button href="/contact">Contact us</Button>
        </ButtonRow>
      </div>
      <Testimonial audience="donors" />
    </Columns>
  </Surface>

  <Surface title="The details" surface="tint">
    <div class="stack">
      <p>
        The {site.legalName} is a 501(c)(3) nonprofit organization, EIN {site.ein}. Donations are
        tax-deductible to the extent allowed by law.
      </p>
    </div>
  </Surface>
</PageLayout>

<style>
  @layer components {
    .gifts {
      display: grid;
      gap: var(--space-s);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .gifts li {
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      align-items: baseline;
      gap: var(--space-s);
    }

    .gifts strong {
      font-family: var(--font-heading);
      font-size: var(--step-3);
      line-height: 1;
      color: var(--heading);
    }

    .ways {
      display: grid;
      gap: var(--space-l) var(--space-m);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .ways li {
      display: grid;
      align-content: start;
      gap: var(--space-xs);
    }

    .ways :global(svg:first-child) {
      color: var(--heading);
    }

    @media (width >= 40rem) {
      .ways {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (width >= 64rem) {
      .ways {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  }
</style>

---
// The contact form. A plain HTML form posted to our own handler on
// Cloudflare (worker/contact.js), which checks it and emails it to
// info@faasl.org; it answers with /message-sent or /message-not-sent.
// Spam protection: Cloudflare Turnstile (an invisible check) and a hidden
// field bots fill in. Emails are switched on at launch (docs/deployment.md).
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import Todo from '../layout/Todo.astro';
import { TOPICS } from '../../../worker/contact.js';
---

<form class="contact-form" method="post" action="/api/contact">
  <Todo block>messages are checked but not emailed until launch (docs/deployment.md)</Todo>
  <p>
    <label for="name">
      Full name <span aria-hidden="true">*</span>
    </label>
    <input id="name" name="name" autocomplete="name" maxlength="100" required />
  </p>
  <p>
    <label for="email">
      Email <span aria-hidden="true">*</span>
    </label>
    <input id="email" name="email" type="email" autocomplete="email" maxlength="200" required />
  </p>
  <p>
    <label for="phone">Phone</label>
    <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
  </p>
  <fieldset>
    <legend>May we text this number?</legend>
    <label>
      <input type="radio" name="texting" value="yes" /> Yes
    </label>
    <label>
      <input type="radio" name="texting" value="no" /> No
    </label>
  </fieldset>
  <p>
    <label for="topic">
      What's this about? <span aria-hidden="true">*</span>
    </label>
    <select id="topic" name="topic" required>
      <option value="">Choose one</option>
      {TOPICS.map((topic) => (
        <option>{topic}</option>
      ))}
    </select>
  </p>
  <p>
    <label for="message">
      Message <span aria-hidden="true">*</span>
    </label>
    <textarea id="message" name="message" rows="6" maxlength="5000" required></textarea>
  </p>
  {/* left empty by people; bots fill it in */}
  <p class="trap" aria-hidden="true">
    <label for="website">Leave this empty</label>
    <input id="website" name="website" tabindex="-1" autocomplete="off" />
  </p>
  <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-theme="light"></div>
  <p class="note">* Required</p>
  <p>
    <button type="submit">Send</button>
  </p>
</form>
{/* Turnstile, Cloudflare's privacy-friendly check, on this page only */}
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  @layer components {
    .contact-form {
      display: grid;
      gap: var(--space-s);
      max-width: 36rem;
    }

    label {
      display: block;
      font-weight: 700;
    }

    fieldset label {
      display: inline-flex;
      gap: 0.25rem;
      margin-right: var(--space-s);
      font-weight: 400;
    }

    input:not([type='radio']),
    select,
    textarea {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid var(--color-ink);
      border-radius: var(--r-control);
    }

    button {
      min-height: 44px;
      padding: 0.5rem 1.25rem;
      border: 0;
      border-radius: var(--r-control);
      background: var(--color-hunter-green);
      color: var(--color-white);
      font-weight: 700;
    }

    .trap {
      position: absolute;
      left: -9999px;
    }

    .note {
      font-size: var(--step--1);
    }
  }
</style>

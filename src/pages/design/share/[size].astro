---
// The social share image, laid out as a page so it uses the real fonts,
// logo and tiles. Built only outside production. To update public/share.png,
// screenshot this page at exactly 1200×630 (docs/brand.md, Share image).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Logo from '../../../components/Logo.astro';
import TilePattern from '../../../components/TilePattern.astro';
import { getSite, isProduction } from '../../../lib/site';

export function getStaticPaths() {
  return isProduction ? [] : [{ params: { size: '1200x630' } }];
}

const site = await getSite();
---

<BaseLayout title="Share image" description="The social share image." noindex>
  <div class="card">
    <div class="tiles">
      <TilePattern variant="checker" tile={105} height="630px" frame={false} />
    </div>
    <div class="box">
      <Logo size={112} />
      <p class="name">{site.name}</p>
      <p class="official">{site.legalName}</p>
      <p class="tagline">{site.tagline}</p>
    </div>
  </div>
</BaseLayout>

<style>
  .card {
    position: relative;
    display: grid;
    place-items: center;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  .tiles {
    position: absolute;
    inset: 0;
  }

  .box {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 40px 64px 44px;
    background: var(--color-hunter-green);
    color: var(--color-white);
    text-align: center;
    border: 6px solid var(--color-gold);
    box-shadow: 0 0 0 10px var(--color-hunter-green);
  }

  .box :global(.logo) {
    color: var(--color-gold);
    margin-bottom: 6px;
  }

  .name {
    font-family: var(--font-heading);
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
  }

  .official {
    font-size: 26px;
    font-weight: 600;
  }

  .tagline {
    padding-top: 14px;
    border-top: 3px solid var(--color-gold);
    font-size: 30px;
    font-style: italic;
  }
</style>

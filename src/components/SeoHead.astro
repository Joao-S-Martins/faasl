---
import { isProduction, getSite, publicPath } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Hide this page from search engines even in production. */
  noindex?: boolean;
  /** Absolute or root-relative URL of the social share image. */
  image?: string;
}

// Pages without their own image share the site-wide card (docs/brand.md).
const { title, description, noindex = false, image = '/share.png' } = Astro.props;
const site = await getSite();

const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(publicPath(Astro.url.pathname), Astro.site);
const imageUrl = new URL(image, Astro.site);
const robots = noindex || !isProduction ? 'noindex, nofollow' : 'index, follow';

const organization = {
  '@context': 'https://schema.org',
  '@type': ['NGO', 'MusicGroup'],
  name: site.name,
  legalName: site.legalName,
  alternateName: site.alternateName,
  url: Astro.site?.href,
  logo: new URL('/logo.png', Astro.site).href,
  foundingDate: String(site.foundingYear),
  email: site.email,
  telephone: site.phone,
  taxID: site.ein,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.clubhouse.street,
    addressLocality: site.clubhouse.city,
    addressRegion: site.clubhouse.region,
    postalCode: site.clubhouse.postalCode,
    addressCountry: 'US',
  },
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  sameAs: site.social.map((s) => s.url),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{image === '/share.png' && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(organization)} />

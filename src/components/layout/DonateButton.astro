---
// A small Donate button floating near the bottom of the screen: always
// available, never pushy (docs/brief.md §3.1). Hidden while the landing
// photo is in view, when the header's own menu is right there.
import HandHeart from '@lucide/astro/icons/hand-heart';
---

<aside aria-label="Donate">
  <a class="donate-float" href="/give">
    <HandHeart size={18} aria-hidden="true" />
    Donate
  </a>
</aside>

<style>
  @layer components {
    .donate-float {
      position: fixed;
      right: var(--gutter);
      bottom: var(--gutter);
      z-index: 15;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      min-height: 44px;
      padding: 0.5rem 1rem;
      border-radius: var(--r-pill);
      background: var(--color-hunter-green);
      color: var(--color-white);
      font-weight: 700;
      font-size: var(--step--1);
      text-decoration: none;
      /* a white ring so it shows on green sections too */
      box-shadow:
        0 0 0 2px var(--color-white),
        0 2px 10px rgb(0 0 0 / 0.25);
      transition:
        opacity var(--duration-fast),
        transform var(--duration-fast);
    }

    :global(.js[data-hero='in']) .donate-float {
      opacity: 0;
      transform: translateY(0.5rem);
      pointer-events: none;
    }
  }
</style>

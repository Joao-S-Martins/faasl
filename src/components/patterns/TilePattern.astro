---
import WallTile from './WallTile.astro';
import { MEASURES, writeStaff } from '../../lib/staff';

// Patterns built from musical motifs, drawn like hand-painted tiles in the
// brand colors
// (docs/brand.md, Portuguese motifs). Decorative only.
interface Props {
  /**
   * Wall tiles: `staff` (one tile high, for bands), `rosette`, and
   * `checker` (the two alternating).
   * Staff lines: `line` (one long staff, a section break) and `field`
   * (offset staves, a background).
   */
  variant?: 'staff' | 'rosette' | 'checker' | 'line' | 'field';
  /** Line color (hunter green by default) and accent (gold, used sparingly). */
  ink?: string;
  accent?: string;
  ground?: string;
  /** Wall tiles: the gap between tiles. */
  grout?: string;
  height?: string;
  tile?: number;
  /**
   * Center the tile grid so cut tiles are equal on both sides: `x` for
   * bands, `both` for walls and banners. A grout line falls on the center.
   */
  center?: 'x' | 'both';
  /** Rounded outline around the whole pattern; off for bands and panels. */
  frame?: boolean;
}

const {
  variant = 'staff',
  ink = 'var(--color-hunter-green)',
  accent = 'var(--color-gold)',
  ground = 'var(--color-white)',
  grout = 'var(--color-off-white)',
  height = '7rem',
  tile = 96,
  frame = true,
  center,
} = Astro.props;
const origin = { x: center ? '50%' : 0, y: center === 'both' ? '50%' : 0 };
// A stable id from the options: the same pattern always gets the same id, so
// builds are repeatable, and two identical patterns on a page can share one.
const key = JSON.stringify([variant, ink, accent, ground, grout, tile, center]);
let hash = 0;
for (const ch of key) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const id = `tile-${variant}-${hash.toString(36)}`;

// The staff lines: eight different measures, so the repeat is hard to spot.
// `field` offsets each staff by a few measures and packs them closely.
const MEASURE = 96;
const lineStaff = writeStaff(MEASURES, 12, MEASURE);
const fieldOrder = [3, 6, 1, 4, 7, 2, 5, 0];
const fieldStaves = [
  writeStaff(MEASURES, 8, MEASURE),
  writeStaff(
    fieldOrder.map((i) => MEASURES[i]),
    48,
    MEASURE,
  ),
];
const staffWidth = MEASURES.length * MEASURE;

const colors = { ink, accent, ground, grout };
---

<svg
  class:list={['tiles', { frame }]}
  style={`height:${height}`}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    {variant === 'checker' && (
      <pattern
        id={id}
        {...origin}
        width={tile * 2}
        height={tile * 2}
        patternUnits="userSpaceOnUse"
        viewBox="0 0 192 192"
      >
        <WallTile kind="rosette" {...colors} />
        <WallTile kind="staff" x={96} {...colors} />
        <WallTile kind="staff" y={96} {...colors} />
        <WallTile kind="rosette" x={96} y={96} {...colors} />
      </pattern>
    )}
    {variant === 'staff' && (
      <pattern
        id={id}
        {...origin}
        width={tile}
        height={tile}
        patternUnits="userSpaceOnUse"
        viewBox="0 0 96 96"
      >
        <WallTile kind="staff" {...colors} />
      </pattern>
    )}
    {variant === 'rosette' && (
      <pattern
        id={id}
        {...origin}
        width={tile}
        height={tile}
        patternUnits="userSpaceOnUse"
        viewBox="0 0 96 96"
      >
        <WallTile kind="rosette" {...colors} />
      </pattern>
    )}
    {(variant === 'line' || variant === 'field') && (
      <pattern
        id={id}
        width={staffWidth}
        height={variant === 'line' ? 48 : 80}
        patternUnits="userSpaceOnUse"
      >
        <rect width={staffWidth} height={variant === 'line' ? 48 : 80} fill={ground} />
        {(variant === 'line' ? [lineStaff] : fieldStaves).map((staff) => (
          <g opacity={variant === 'line' ? 0.35 : 0.16} stroke-linecap="round">
            <path d={staff.lines} fill="none" stroke={ink} stroke-width="1" />
            <path d={staff.beams} fill="none" stroke={ink} stroke-width="3" stroke-linecap="butt" />
            <path d={staff.flags} fill={ink} />
            {staff.heads.map((head) => (
              <ellipse
                cx={head.x}
                cy={head.y}
                rx={head.whole ? 4.2 : 3.6}
                ry="2.6"
                transform={head.whole ? undefined : `rotate(-22 ${head.x} ${head.y})`}
                fill={head.open ? ground : ink}
                stroke={head.open ? ink : 'none'}
                stroke-width={head.whole ? 1.8 : 1.2}
              />
            ))}
          </g>
        ))}
      </pattern>
    )}
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<style>
  @layer components {
    .tiles {
      display: block;
      width: 100%;
    }

    .frame {
      border-radius: var(--radius);
      border: 1px solid #ddd;
    }
  }
</style>

---
// People cards for a role (leadership, teacher, conductor…), in `order`.
import { getCollection } from 'astro:content';
import { isVisible } from '../lib/site';
import PersonCard from './PersonCard.astro';

interface Props {
  role: 'leadership' | 'teacher' | 'conductor' | 'volunteer' | 'musician';
  compact?: boolean;
}

const { role, compact = false } = Astro.props;
const people = (
  await getCollection('people', (entry) => isVisible(entry) && entry.data.roles.includes(role))
).sort((a, b) => a.data.order - b.data.order);
---

<div class="people">
  {people.map((person) => (
    <PersonCard person={person} compact={compact} />
  ))}
</div>

<style>
  .people {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
</style>

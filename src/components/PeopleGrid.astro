---
// People cards for a role (leadership, teacher, conductor…), in `order`.
import { getCollection } from 'astro:content';
import { isVisible } from '../lib/site';
import PersonCard from './PersonCard.astro';

interface Props {
  role: 'leadership' | 'teacher' | 'conductor' | 'volunteer' | 'musician';
  compact?: boolean;
  /** A sideways-scrolling row on phones and tablets; a grid on desktop. */
  scroll?: boolean;
}

const { role, compact = false, scroll = false } = Astro.props;
const people = (
  await getCollection('people', (entry) => isVisible(entry) && entry.data.roles.includes(role))
).sort((a, b) => a.data.order - b.data.order);
---

<div class:list={['people', { scroll }]}>
  {people.map((person) => (
    <PersonCard person={person} compact={compact} />
  ))}
</div>

<style>
  .people {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  /* Desktop: narrower columns so a short row doesn't leave one card alone */
  @media (min-width: 64rem) {
    .scroll {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  @media (max-width: 63.99rem) {
    .scroll {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(75%, 17rem);
      gap: var(--space-s);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0.25rem var(--gutter) var(--space-s);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* snap cards to the gutter, not the screen edge */
      scroll-padding-inline: var(--gutter);
    }

    .scroll > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>

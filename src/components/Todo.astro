---
// Marks missing content. Visible on beta and local builds as a reminder;
// renders nothing in production.
import { isProduction } from '../lib/site';

interface Props {
  /** Render as a block (own paragraph) instead of inline. */
  block?: boolean;
}

const { block = false } = Astro.props;
const Tag = block ? 'p' : 'span';
---

{!isProduction && (
  <Tag class:list={['todo', { block }]}>
    <strong>TODO:</strong> <slot />
  </Tag>
)}

<style>
  .todo {
    background: var(--color-light-gold);
    color: var(--color-ink);
    padding: 0 0.25em;
    border-radius: 0.25em;
  }

  .todo.block {
    display: block;
    padding: var(--space-xs) var(--space-s);
    border-left: 4px solid var(--color-gold);
  }
</style>

---
// Every site page: base document + skip link + header + main + footer.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <SiteHeader />
  <main id="main" class="container">
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
  }

  .skip-link:focus {
    left: var(--gutter);
    top: var(--gutter);
    padding: var(--space-xs) var(--space-s);
    background: var(--color-white);
    z-index: 10;
  }
</style>

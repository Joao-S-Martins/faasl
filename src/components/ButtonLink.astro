---
// A link styled as a call to action.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a class:list={['button', variant]} href={href}>
  <slot />
</a>

<style>
  .button {
    display: inline-block;
    padding: 0.625rem 1.125rem;
    border: 2px solid var(--color-hunter-green);
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: var(--color-hunter-green);
    color: var(--color-white);
  }

  .secondary {
    background: transparent;
    color: var(--color-hunter-green);
  }
</style>

---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import Surface from '../components/blocks/Surface.astro';
import DetailList from '../components/blocks/DetailList.astro';
import Todo from '../components/layout/Todo.astro';
import { getSite, yearsSince } from '../lib/site';

const site = await getSite();
const impact = (await getEntry('impact', 'current'))!.data;
const cities = site.areaServed.join(', ');
---

<PageLayout
  title="Our Impact"
  description="Free music education and community performances in San Leandro since 1980. Mission, programs, numbers, governance and documents for the Portuguese Band of San Leandro, a 501(c)(3) nonprofit."
  hero
  bare
>
  <Hero
    size="page"
    surface="tint"
    needs="students in a lesson with the teacher, or young and older musicians side by side"
  >
    <h1>Our Impact</h1>
    <p class="sub">{`free music education and community music since ${site.foundingYear}`}</p>
  </Hero>

  <Surface title="Our mission">
    <div class="stack">
      <p>
        The Portuguese Band of San Leandro provides free music education and mentorship to musicians
        of all ages, and brings live music to our community.
      </p>
      <Todo block>final mission wording with the board (this is the working draft)</Todo>
    </div>
  </Surface>

  <Surface title="At a glance" surface="tint">
    <div class="stack">
      <DetailList
        facts={[
          {
            term: 'Founded',
            detail: `${site.foundingYear} (${yearsSince(site.foundingYear)} years of free music education)`,
          },
          { term: 'Status', detail: `501(c)(3) nonprofit, EIN ${site.ein}` },
          { term: 'Run by', detail: 'Volunteers' },
          { term: 'Lessons', detail: 'Free, weekly, ages 8 to 108' },
          {
            term: 'Lesson classes',
            detail: `${impact.classes} classes, each with ${impact.regularStudentsPerClass} regular students (${impact.studentsPerClassPerYear} per class over a year)`,
          },
          { term: 'Band', detail: `${impact.bandMusicians} musicians (${impact.year})` },
          {
            term: 'Performances',
            detail: `${impact.paradesPerYear} parades and ${impact.concertsPerYear} concerts a year`,
          },
          { term: 'Where', detail: cities },
        ]}
      />
      <Todo block>
        more numbers: the share of revenue that goes to programs rather than administration, and
        estimates of volunteer hours and hours of performances for the community each year
        (docs/todo.md)
      </Todo>
      <Todo block>
        quotes: Ryan, the San Leandro High School band director, on the difference he sees in
        students who take part; a family on tradition; someone on the bonds the band builds
      </Todo>
    </div>
  </Surface>

  <Surface title="Our programs">
    <div class="stack">
      <ul>
        <li>
          <strong>Free music lessons:</strong> weekly beginner and intermediate group classes for
          ages 8 to 108, taught by a music teacher who also teaches in San Leandro schools. Students
          can start any time of year.
        </li>
        <li>
          <strong>Volunteer community band:</strong> a mixed-age band where students play alongside
          experienced musicians, rehearsing weekly. No auditions, no fees.
        </li>
        <li>
          <strong>Community performances:</strong> parades, festivals, city events and holiday
          caroling around the SF Bay and Central Valley, free to the public.
        </li>
        <li>
          <strong>Community dinners:</strong> fundraiser dinners throughout the year that bring
          people together and support the programs.
        </li>
      </ul>
    </div>
  </Surface>

  <Surface title="Who we serve" surface="tint">
    <div class="stack">
      <p>
        Students and musicians from San Leandro and neighboring communities, including{' '}
        {site.areaServed.slice(1, -1).join(', ')} and {site.areaServed.at(-1)}, from age 8 to adults
        of every age. Lessons and band membership are free, so cost is never a barrier to music.
      </p>
      <Todo block>revisit this section later, with local search in mind</Todo>
    </div>
  </Surface>

  <Surface title="Governance">
    <div class="stack">
      <p>
        The band is governed by a volunteer board of directors. Board members aren't paid; our funds
        go to our building and our musical needs.
      </p>
      <Todo block>
        the board of directors (a different board from the leadership team on Home and About), with
        names, roles and short bios; research fund use before adding claims (docs/todo.md)
      </Todo>
    </div>
  </Surface>

  <Surface title="Documents" surface="tint">
    <div class="stack">
      <Todo block>
        IRS determination letter, most recent Form 990, annual report or financial summary (PDFs)
      </Todo>
    </div>
  </Surface>

  <Surface title="Verify us">
    <div class="stack">
      <ul>
        <li>
          <a href="https://apps.irs.gov/app/eos/">IRS Tax Exempt Organization Search</a>: search EIN{' '}
          {site.ein}
        </li>
        <li>
          Candid (GuideStar) profile <Todo>claim and link</Todo>
        </li>
        <li>
          California Attorney General, Registry of Charitable Trusts{' '}
          <Todo>confirm status and link</Todo>
        </li>
      </ul>
    </div>
  </Surface>

  <Surface title="Grants and partnerships" surface="tint">
    <div class="stack">
      <p>
        Contact us at <a href={`mailto:${site.email}`}>{site.email}</a>.
        <Todo>a named contact, if any</Todo>
      </p>
    </div>
  </Surface>
</PageLayout>

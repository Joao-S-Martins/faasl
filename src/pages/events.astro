---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import Surface from '../components/blocks/Surface.astro';
import EventList from '../components/content/EventList.astro';
import CalendarLink from '../components/content/CalendarLink.astro';
import parade from '../assets/photos/parade-carnival.jpg';
import gym from '../assets/photos/concert-band-gym.jpg';
import Columns from '../components/blocks/Columns.astro';
import PhotoBreak from '../components/blocks/PhotoBreak.astro';
import { getEventPages } from '../lib/events';

// Past events stay listed only if they have a write-up.
const pastWriteups = (await getEventPages())
  .filter((page) => !page.event && page.writeup)
  .sort((a, b) => b.slug.localeCompare(a.slug));
---

<PageLayout
  title="Events"
  description="Fundraiser dinners, parades and concerts with the Portuguese Band of San Leandro. Join us at a dinner or come hear us play across the SF Bay Area."

  hero
  bare
>
  <Hero image={parade} alt="The band marching at a street fair" size="page" surface="tint">
    <h1>Events</h1>
    <p class="sub">dinners, parades and concerts</p>
  </Hero>

  <Surface surface="tint">
    <div class="stack measure">
      <p>
        There are two great ways to spend time with us: share a meal at one of our fundraiser
        dinners, or come hear us play. Our dinners keep our music lessons free, and our performances
        are free to enjoy.
      </p>
    </div>
  </Surface>

  <Surface title="Fundraisers and social events" id="fundraisers">
    <div class="stack">
      <p>
        Throughout the year we host dinners that bring classic Portuguese meals to the table, along
        with some American staples, and from time to time other fundraisers like raffles. Every
        ticket supports our free music programs. Tickets are available at the door or from any board
        member.
      </p>
      <EventList
        calendar="social"
        empty="No fundraisers are scheduled right now. Add our social calendar to yours to hear about the next one."
      />
      <p>
        <CalendarLink calendar="social" /> · Can't make it? <a href="/give">Support the band</a>
      </p>
    </div>
  </Surface>

  <PhotoBreak image={gym} alt="The band in concert, the conductor on a riser" />

  <Surface title="Performances" id="performances" surface="tint">
    <Columns split="wide-start">
      <div class="stack">
        <p>
          We play about a dozen parades and half a dozen concerts every year, from Holy Ghost festas
          to city celebrations.
        </p>
        <EventList
          calendar="performances"
          empty="No performances are scheduled right now. Add our performance calendar to yours to hear about the next one."
        />
        <p>
          <CalendarLink calendar="performances" />
        </p>
      </div>
      <div class="stack">
        <h3>What we perform at</h3>
        <ul>
          <li>
            <strong>Holy Ghost parades:</strong> hosted by Portuguese communities throughout the
            year
          </li>
          <li>
            <strong>Music festivals</strong>
          </li>
          <li>
            <strong>City events:</strong> the Cherry Festival parade and others
          </li>
          <li>
            <strong>Caroling:</strong> bringing cheer to the holiday season
          </li>
        </ul>
      </div>
    </Columns>
  </Surface>
  {pastWriteups.length > 0 && (
    <Surface title="Past events" id="past">
      <div class="stack">
        <ul>
          {pastWriteups.map(({ slug, writeup }) => (
            <li>
              <a href={`/events/${slug}`}>{writeup!.data.title}</a>
              {' · '}
              {writeup!.data.summary}
            </li>
          ))}
        </ul>
      </div>
    </Surface>
  )}
</PageLayout>

---
// Design-phase header: large over the landing image, compact once the
// landing image scrolls away (docs/brief.md §3.1). Fixed, so shrinking never
// moves the page. A hamburger menu on phones (<details>, works without
// JavaScript), the full menu on wide screens.
import Menu from '@lucide/astro/icons/menu';
import { mainNav } from '../../lib/navigation';
import { getSite } from '../../lib/site';
import Logo from '../Logo.astro';

interface Props {
  /** `solid`: white bar. `over-photo`: transparent over the hero, solid once compact. */
  look: 'solid' | 'over-photo';
  base: string;
}

const { look, base } = Astro.props;
const site = await getSite();
const nav = mainNav.map((item) =>
  item.href === '/lessons' ? { ...item, href: `${base}/lessons` } : item,
);
---

<header class:list={['dheader', look]}>
  <div class="bar">
    <a class="brand" href={`${base}/home`}>
      <Logo size={64} />
      <span class="name">{site.name}</span>
    </a>
    <nav aria-label="Main" class="wide-nav">
      <ul>
        {nav.map(({ href, label }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <details class="menu">
      <summary aria-label="Menu">
        <Menu size={28} aria-hidden="true" />
      </summary>
      <nav aria-label="Main">
        <ul>
          {nav.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
          <li>
            <a class="menu-donate" href="/give">
              Donate
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .dheader {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--color-hunter-green);
    background: var(--color-white);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: 0.5rem var(--gutter);
    transition: padding 0.2s;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    color: inherit;
    text-decoration: none;
  }

  /* gold lyre on white is too faint; green there, gold over photos and green */
  .brand :global(.logo) {
    color: var(--color-hunter-green);
  }

  .brand :global(svg) {
    width: 40px;
    height: 40px;
    transition:
      width 0.2s,
      height 0.2s;
  }

  .name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.05;
    max-width: 11em;
    transition: font-size 0.2s;
  }

  /* Large while the landing image is in view (set by DesignLayout's script) */
  :global([data-hero='in']) .bar {
    padding-block: 1rem;
  }

  :global([data-hero='in']) .brand :global(svg) {
    width: 64px;
    height: 64px;
  }

  :global([data-hero='in']) .name {
    font-size: 1.6rem;
  }

  .over-photo {
    background: var(--color-hunter-green);
    color: var(--color-white);
  }

  .over-photo .brand :global(.logo) {
    color: var(--color-gold);
  }

  /* Over the photo: a dark fade behind the bar and a soft shadow on the
     text, so it stays readable over light photos and video */
  :global([data-hero='in']) .over-photo {
    background: linear-gradient(rgb(0 0 0 / 0.7), rgb(0 0 0 / 0.35) 70%, transparent);
    box-shadow: none;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.6);
  }

  .wide-nav {
    display: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wide-nav ul {
    display: flex;
    gap: var(--space-m);
  }

  nav a {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    list-style: none;
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    inset: 100% 0 auto;
    padding: var(--space-s) var(--gutter) var(--space-m);
    background: var(--color-white);
    color: var(--color-hunter-green);
    box-shadow: 0 8px 16px rgb(0 0 0 / 0.12);
  }

  .menu li a {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-off-white);
    font-size: var(--step-1);
  }

  .menu .menu-donate {
    border: 0;
    font-weight: 700;
  }

  @media (min-width: 64rem) {
    .wide-nav {
      display: block;
    }

    .menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dheader,
    .bar,
    .brand :global(svg),
    .name {
      transition: none;
    }
  }
</style>

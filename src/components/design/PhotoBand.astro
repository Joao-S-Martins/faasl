---
// A full-width background photo with a content box over it, e.g. for a
// testimonial (docs/brief.md §3.1, after Sphinx). On phones the box butts
// against the photo's bottom edge instead of covering the faces.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  align?: 'left' | 'right';
  /** Box color: white when the section before is green. */
  tone?: 'green' | 'white';
}

const { image, alt, align = 'right', tone = 'green' } = Astro.props;
---

<section class:list={['photo-band', align, tone]}>
  <Image src={image} alt={alt} width={1600} widths={[640, 1000, 1600]} sizes="100vw" class="bg" />
  <div class="inner">
    <div class="box">
      <slot />
    </div>
  </div>
</section>

<style>
  .photo-band {
    position: relative;
    display: grid;
  }

  .bg {
    width: 100%;
    height: 18rem;
    object-fit: cover;
  }

  .inner {
    max-width: var(--content-width);
    width: 100%;
    margin-inline: auto;
  }

  .box {
    padding: var(--space-l) var(--gutter);
    background: var(--color-hunter-green);
    color: var(--color-white);
  }

  .box :global(a),
  .box :global(h2) {
    color: inherit;
  }

  .white .box {
    background: var(--color-white);
    color: var(--color-ink);
  }

  .white .box :global(a),
  .white .box :global(h2) {
    color: var(--color-hunter-green);
  }

  @media (min-width: 48rem) {
    .photo-band {
      min-height: 30rem;
    }

    .bg {
      position: absolute;
      inset: 0;
      height: 100%;
    }

    .inner {
      position: relative;
      display: flex;
      align-items: center;
      padding: var(--space-xl) var(--gutter);
    }

    .left .inner {
      justify-content: flex-start;
    }

    .right .inner {
      justify-content: flex-end;
    }

    .box {
      max-width: 30rem;
      padding: var(--space-l);
      border-radius: var(--radius);
      background: rgb(53 87 73 / 0.94);
    }

    .white .box {
      background: rgb(255 255 255 / 0.96);
    }
  }
</style>

---
// A small Donate button floating near the bottom of the screen: always
// available, never pushy (docs/brief.md §3.1). Hidden while the landing
// image is in view, when the header's own menu is right there.
import HandHeart from '@lucide/astro/icons/hand-heart';
---

<a class="donate-float" href="/give">
  <HandHeart size={18} aria-hidden="true" />
  Donate
</a>

<style>
  .donate-float {
    position: fixed;
    right: var(--gutter);
    bottom: var(--gutter);
    z-index: 15;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--color-hunter-green);
    color: var(--color-white);
    font-weight: 700;
    font-size: var(--step--1);
    text-decoration: none;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  :global([data-hero='in']) .donate-float {
    opacity: 0;
    transform: translateY(0.5rem);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .donate-float {
      transition: none;
    }
  }
</style>

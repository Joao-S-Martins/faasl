---
// Phase 1 test page: exercises the whole pipeline (content, images, React,
// SEO head, deploys). Never indexed. Removed before launch.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_ENV } from 'astro:env/server';
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonCard from '../components/PersonCard.astro';
import InstrumentPicker from '../components/InstrumentPicker';
import rehearsal from '../assets/photos/students-rehearsal.jpg';
import { getSite, isVisible, yearsSince } from '../lib/site';

const site = await getSite();
const people = (await getCollection('people', isVisible)).sort(
  (a, b) => a.data.order - b.data.order,
);
const instruments = (await getCollection('instruments')).map(({ id, data }) => ({
  id,
  name: data.name,
  beginnerFriendly: data.beginnerFriendly,
  demoStartSeconds: data.demoStartSeconds,
}));
const stores = (await getCollection('stores', ({ data }) => data.status === 'open')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
const [story] = await getCollection('stories', isVisible);
const builtAt = new Date().toISOString();
---

<BaseLayout
  title="Test page"
  description="Infrastructure test page for the v3 site."
  image={rehearsal.src}
  noindex
>
  <main class="container stack">
    <header>
      <p class="eyebrow">v3 test page</p>
      <h1>{site.name}</h1>
      <p>
        {site.legalName}, founded in {site.foundingYear}: {yearsSince(site.foundingYear)} years of
        music.
      </p>
    </header>

    <section class="stack">
      <h2>Optimized photo</h2>
      <Image
        src={rehearsal}
        alt="Students rehearsing with the conductor"
        width={1600}
        widths={[400, 800, 1200, 1600]}
        sizes="(min-width: 70rem) 70rem, 100vw"
        class="photo"
      />
      <p class="note">
        Original: {rehearsal.width}×{rehearsal.height}. The browser picks a resized WebP that fits
        the screen.
      </p>
    </section>

    <section class="stack">
      <h2>People from the content collection</h2>
      <div class="grid">
        {people.map((person) => (
          <PersonCard person={person} />
        ))}
      </div>
    </section>

    <section class="stack">
      <h2>React island</h2>
      <InstrumentPicker client:visible videoId="CCTeSjpDsIs" instruments={instruments} />
    </section>

    <section class="stack">
      <h2>Structured content</h2>
      {story && (
        <blockquote>
          <p>“{story.data.quote}”</p>
          <footer>— {story.data.name}</footer>
        </blockquote>
      )}
      <h3>Open music stores</h3>
      <ul>
        {stores.map(({ data }) => (
          <li>
            <a href={data.url}>{data.name}</a>
            {data.city && `, ${data.city}`}
          </li>
        ))}
      </ul>
      <h3>FAQ</h3>
      {faqs.map(({ data }) => (
        <details>
          <summary>{data.question}</summary>
          <p>{data.answer}</p>
        </details>
      ))}
    </section>

    <section class="stack">
      <h2>Build info</h2>
      <dl>
        <dt>Environment</dt>
        <dd>{SITE_ENV}</dd>
        <dt>Built</dt>
        <dd>
          <time datetime={builtAt}>{builtAt}</time>
        </dd>
      </dl>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    padding-block: var(--space-l);
  }

  .stack {
    display: grid;
    gap: var(--space-m);
  }

  main.stack {
    gap: var(--space-xl);
  }

  .eyebrow {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-hunter-green);
  }

  .photo {
    width: 100%;
    border-radius: var(--radius);
  }

  .note {
    font-size: var(--step--1);
  }

  .grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-xs) var(--space-m);
  }

  dt {
    font-weight: 700;
  }
</style>

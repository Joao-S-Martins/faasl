---
// A recessed tray around a sideways-scrolling row. The row is clipped by the
// tray's rounded corners, and a rim drawn over it makes cards look like they
// slide under the tray's edge. The rim ignores taps, so it never blocks the
// cards.
interface Props {
  /** `dark` for green sections, `light` for white ones. */
  tone: 'dark' | 'light';
}

const { tone } = Astro.props;
---

<div class:list={['well', tone]}>
  <slot />
</div>

<style>
  .well {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
  }

  .well::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  /* the row inside sits flush in the tray, snapping to its padding */
  .well.well > :global(*) {
    margin: 0;
    padding: 1rem;
    scroll-padding-inline: 1rem;
  }

  .dark {
    background: rgb(0 0 0 / 0.22);
  }

  .dark::after {
    box-shadow:
      inset 0 0 0 8px #2b473b,
      inset 0 3px 10px 4px rgb(0 0 0 / 0.45);
  }

  .light {
    background: var(--color-off-white);
  }

  .light::after {
    box-shadow:
      inset 0 0 0 8px #e4e6e4,
      inset 0 3px 10px 4px rgb(0 0 0 / 0.14);
  }

  /* off-white cards would disappear in the off-white tray */
  .light :global(.person) {
    background: var(--color-white);
  }
</style>

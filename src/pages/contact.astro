---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import Surface from '../components/blocks/Surface.astro';
import Columns from '../components/blocks/Columns.astro';
import ContactForm from '../components/blocks/ContactForm.astro';
import Address from '../components/content/Address.astro';
import SocialLinks from '../components/content/SocialLinks.astro';
import { getSite } from '../lib/site';
import { fillTokens } from '../lib/schedule';

const site = await getSite();
const schedule = await fillTokens('{{schedule}}');
---

<PageLayout
  title="Contact Us"
  description={await fillTokens(
    `Contact the Portuguese Band of San Leandro: {{address}}, CA. Call ${site.phone} or email ${site.email}.`,
  )}
  hero
  bare
>
  <Hero
    size="page"
    surface="tint"
    needs="the clubhouse at 844 Alvarado St. from the street (the same photo as Visit us on Home)"
  >
    <h1>Contact Us</h1>
    <p class="sub">we'd love to hear from you</p>
  </Hero>

  <Surface surface="tint">
    <div class="stack measure">
      <p>
        Questions about lessons, the band, giving or anything else? Send us a message and we'll get
        back to you soon. You're also welcome to just stop by on a Friday evening.
      </p>
    </div>
  </Surface>

  <Surface>
    <Columns split="wide-start">
      <div class="stack">
        <h2 id="send-a-message">Send a message</h2>
        <ContactForm />
      </div>
      <aside class="details stack" aria-label="Other ways to reach us">
        <h2 id="visit-us">Visit us</h2>
        <Address directions />
        <p>{schedule}</p>
        <h2 id="call-or-email">Call or email</h2>
        <p>
          <a href={`tel:+1${site.phone.replace(/\D/g, '')}`}>{site.phone}</a> (please leave a
          message)
          <br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <h2 id="mail">Mail</h2>
        <Address which="mailing" />
        <h2 id="follow-us">Follow us</h2>
        <SocialLinks />
      </aside>
    </Columns>
  </Surface>
</PageLayout>

<style>
  @layer components {
    .details {
      align-self: start;
      padding: var(--space-l);
      border-radius: var(--r-box);
      background: var(--color-off-white);
    }

    .details h2 {
      font-size: var(--step-2);
    }

    .details h2:not(:first-child) {
      margin-top: var(--space-m);
    }
  }
</style>

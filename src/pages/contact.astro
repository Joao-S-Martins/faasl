---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/ContactForm.astro';
import Address from '../components/Address.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getSite } from '../lib/site';
import { fillTokens } from '../lib/schedule';

const site = await getSite();
const schedule = await fillTokens('{{schedule}}');
---

<PageLayout
  title="Contact Us"
  description={await fillTokens(
    `Contact the Portuguese Band of San Leandro: {{address}}, CA. Call ${site.phone} or email ${site.email}.`,
  )}
>
  <PageHeader title="Contact Us" subtitle="we'd love to hear from you">
    <p>
      Questions about lessons, the band, giving or anything else? Send us a message and we'll get
      back to you soon. You're also welcome to just stop by on a Friday evening.
    </p>
  </PageHeader>

  <Section title="Send a message">
    <ContactForm />
  </Section>

  <Section title="Visit us">
    <Address directions />
    <p>{schedule}</p>
  </Section>

  <Section title="Mail">
    <Address which="mailing" />
  </Section>

  <Section title="Call or email">
    <p>
      <a href={`tel:+1${site.phone.replace(/\D/g, '')}`}>{site.phone}</a> (please leave a message) ·
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </Section>

  <Section title="Follow us">
    <SocialLinks />
  </Section>
</PageLayout>

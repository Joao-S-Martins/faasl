---
import PageLayout from '../layouts/PageLayout.astro';
import Surface from '../components/blocks/Surface.astro';
import FormList from '../components/content/FormList.astro';
import CalendarLink from '../components/content/CalendarLink.astro';
import EventList from '../components/content/EventList.astro';
import Todo from '../components/layout/Todo.astro';
import { getSite } from '../lib/site';
import { fillTokens } from '../lib/schedule';

const site = await getSite();
const thisWeek = await fillTokens('{{schedule}}, at {{address}}.');
---

<PageLayout
  title="Musicians"
  description="Forms, calendars and contacts for current students, families and band musicians of the Portuguese Band of San Leandro."
  noindex

  bare
>
  <Surface surface="tint">
    <div class="stack measure">
      <h1>Musicians</h1>
      <p class="sub">everything for current students, families and musicians</p>
      <p>Welcome to the band! This page has the forms, apps, calendars and contacts you'll need.</p>
    </div>
  </Surface>

  <Surface title="New member? Start here">
    <div class="stack">
      <p>Print, fill in and return these forms:</p>
      <FormList />
      <p>
        Return completed forms to <strong>Geronimo</strong>.
        <Todo>replace with a role-based contact</Todo>
      </p>
    </div>
  </Surface>

  <Surface title="Stay in the loop" surface="tint">
    <div class="stack">
      <ul>
        <li>
          <strong>BAND app:</strong> we use BAND for band messages and RSVPs.
          <Todo>install links for iPhone and Android, and how to join our group</Todo>
        </li>
        <li>
          <strong>Remind:</strong> lesson updates for students and families.{' '}
          <Todo>how to join</Todo>
        </li>
        <li>
          <strong>Calendars:</strong>
          <ul>
            <li>
              <CalendarLink calendar="lessons" />
            </li>
            <li>
              <CalendarLink calendar="performances" />
            </li>
            <li>
              <CalendarLink calendar="social" />
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </Surface>

  <Surface title="Coming up">
    <div class="stack">
      <p>Regular schedule: {thisWeek}</p>
      <EventList
        calendar="lessons"
        days={21}
        compact
        empty="No lessons or rehearsals are scheduled in the next three weeks."
      />
    </div>
  </Surface>

  <Surface title="Play along at home" surface="tint">
    <div class="stack">
      <p>
        Practice with our{' '}
        <a href="https://www.youtube.com/playlist?list=PLUc6RuyKwWdnL192YgHQ5P-VH8CVN3MEU">
          play-along playlist on YouTube
        </a>
        .<Todo>revive and update the playlist</Todo>
      </p>
    </div>
  </Surface>

  <Surface title="Who to contact">
    <div class="stack">
      <dl>
        <dt>Missing or late to a lesson</dt>
        <dd>
          Edgard <Todo>how to reach him</Todo>
        </dd>
        <dt>Forms, uniforms, music and folders</dt>
        <dd>
          Geronimo <Todo>replace with a role-based contact</Todo>
        </dd>
        <dt>Everything else</dt>
        <dd>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </dd>
      </dl>
    </div>
  </Surface>
</PageLayout>

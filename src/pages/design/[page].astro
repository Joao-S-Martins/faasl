---
// Design-phase pages, built only for beta and local previews (never in
// production). /design/brand is the brand guide; decisions live in
// docs/brand.md.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '@fontsource/abril-fatface';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Logo from '../../components/Logo.astro';
import TilePattern from '../../components/TilePattern.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import Actions from '../../components/Actions.astro';
import { contrast, rating } from '../../lib/contrast';
import { getSite, isProduction } from '../../lib/site';

export function getStaticPaths() {
  return isProduction ? [] : [{ params: { page: 'brand' } }];
}

const site = await getSite();

const palette = [
  { name: 'Hunter green', hex: '#355749', role: 'Primary: buttons, links, headings' },
  {
    name: 'FAASL green',
    hex: '#00A079',
    role: 'Official green: bands of color, icons, large type',
  },
  { name: 'Gold', hex: '#F3DD3E', role: 'Accent: the lyre, highlights, Donate' },
  { name: 'Light gold', hex: '#FFEB5B', role: 'Light backgrounds, highlights' },
  { name: 'White', hex: '#FFFFFF', role: 'Page background (uniform shirts, pants, hats)' },
  { name: 'Off-white', hex: '#F0F0F0', role: 'Surfaces, text on dark green' },
  { name: 'Ink', hex: '#333333', role: 'Body text' },
];

const pairs = [
  { fg: '#333333', bg: '#FFFFFF', label: 'Ink on white' },
  { fg: '#355749', bg: '#FFFFFF', label: 'Hunter green on white' },
  { fg: '#FFFFFF', bg: '#355749', label: 'White on hunter green' },
  { fg: '#F3DD3E', bg: '#355749', label: 'Gold on hunter green' },
  { fg: '#333333', bg: '#F3DD3E', label: 'Ink on gold' },
  { fg: '#355749', bg: '#FFEB5B', label: 'Hunter green on light gold' },
  { fg: '#FFFFFF', bg: '#00A079', label: 'White on FAASL green' },
  { fg: '#333333', bg: '#00A079', label: 'Ink on FAASL green' },
  { fg: '#00A079', bg: '#FFFFFF', label: 'FAASL green on white' },
  { fg: '#F3DD3E', bg: '#FFFFFF', label: 'Gold on white' },
].map((pair) => ({ ...pair, ratio: contrast(pair.fg, pair.bg) }));

const fontPairs = [
  {
    id: 'a',
    name: 'A · Warm heritage',
    heading: "'Fraunces Variable', Georgia, serif",
    body: "'Source Sans 3 Variable', system-ui, sans-serif",
    note: 'Fraunces (a soft, characterful serif) with Source Sans 3. Trustworthy and warm; reads well for long text and giving pages.',
  },
  {
    id: 'b',
    name: 'B · Marching band',
    heading: "'Barlow Condensed', 'Arial Narrow', sans-serif",
    body: "'Barlow', system-ui, sans-serif",
    note: 'Barlow Condensed with Barlow. Uniform-like, energetic and modern; strong for headings and event listings.',
  },
  {
    id: 'c',
    name: 'C · Familiar (closest to v2)',
    heading: "'Abril Fatface', Georgia, serif",
    body: "'Lato', system-ui, sans-serif",
    note: 'Abril Fatface (the free cousin of the old site’s Abril Display) with Lato. Bold and classic; headings only, never long text.',
  },
];

const taglines = [
  { text: site.tagline, source: 'Current tagline' },
  {
    text: 'Dedicated to bringing free music education and public performance opportunities to the greater East Bay.',
    source: 'From the 2018 brochure',
  },
  {
    text: 'Free music lessons and live music for our community, since 1980.',
    source: 'New option',
  },
  { text: 'Music for every age. Free since 1980.', source: 'New option (short)' },
  { text: 'Where generations play together.', source: 'New option (short)' },
];
---

<PageLayout title="Brand guide" description="Beta-only brand guide for the v3 site." noindex>
  <PageHeader title="Brand guide" subtitle="beta only: for choosing the look of v3">
    <p>
      Names, logo, colors, fonts, taglines and patterns, shown in place so they can be judged on a
      phone. Decisions are recorded in <code>docs/brand.md</code>.
    </p>
  </PageHeader>

  <Section title="Names">
    <p class="name-lead">{site.name}</p>
    <p class="name-official">{site.legalName}</p>
    <p>
      The English name leads; the official name, with its accent, appears beneath it or in the
      footer. The members' shorthand, {site.alternateName}, stays off public headings.
    </p>
  </Section>

  <Section title="Logo lockups">
    <div class="lockups">
      <div class="lockup on-white">
        <Logo size={64} />
        <div>
          <p class="lockup-name">{site.name}</p>
          <p class="lockup-official">{site.legalName}</p>
        </div>
      </div>
      <div class="lockup on-hunter">
        <Logo size={64} />
        <div>
          <p class="lockup-name">{site.name}</p>
          <p class="lockup-official">{site.legalName}</p>
        </div>
      </div>
      <div class="lockup on-gold">
        <Logo size={64} />
        <div>
          <p class="lockup-name">{site.name}</p>
          <p class="lockup-official">{site.legalName}</p>
        </div>
      </div>
      <div class="lockup stacked on-white">
        <Logo size={96} />
        <p class="lockup-name">{site.name}</p>
      </div>
    </div>
    <p class="note">
      The gold lyre works on white and hunter green; on gold backgrounds it switches to ink. The
      uniform crest joins these once a vector exists.
    </p>
  </Section>

  <Section title="Colors">
    <ul class="swatches">
      {palette.map(({ name, hex, role }) => (
        <li>
          <span class="chip" style={`background:${hex}`} />
          <span>
            <strong>{name}</strong> <code>{hex}</code>
            <br />
            <span class="note">{role}</span>
          </span>
        </li>
      ))}
    </ul>
    <h3>The uniform</h3>
    <div
      class="uniform"
      aria-label="Uniform colors: green jacket and tie, white shirt, pants and hat, gold lyre"
    >
      <span style="background:#355749">Jacket &amp; tie</span>
      <span style="background:#FFFFFF;color:#333">Shirt, pants, hat</span>
      <span style="background:#F3DD3E;color:#333">Lyre</span>
    </div>
    <p class="note">Site green to be matched to a daylight photo of a jacket.</p>
  </Section>

  <Section title="Readable color pairs">
    <p>Checked against WCAG 2.2 AA (4.5:1 for normal text, 3:1 for large text).</p>
    <ul class="pairs">
      {pairs.map(({ fg, bg, label, ratio }) => (
        <li style={`color:${fg};background:${bg}`}>
          <strong>{label}</strong>
          <span>
            {ratio}:1 · {rating(ratio)}
          </span>
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Buttons and links">
    <Actions>
      <ButtonLink href="#">Join the band</ButtonLink>
      <ButtonLink href="#" variant="secondary">
        Our story
      </ButtonLink>
      <a class="donate-sample" href="#">
        Donate
      </a>
      <a href="#">A text link</a>
    </Actions>
  </Section>

  <Section title="Font pairings">
    {fontPairs.map(({ id, name, heading, body, note }) => (
      <article class="font-pair" id={`fonts-${id}`} style={`--heading:${heading};--body:${body}`}>
        <p class="pair-name">{name}</p>
        <p class="pair-h1">We've built a community around music</p>
        <p class="pair-h2">Free music lessons for ages 8 to 108</p>
        <p class="pair-body">
          Our band was founded in 1980 by amateur musicians, mostly Portuguese immigrants, who
          wanted to enrich their community through music. Today we're a diverse, all-volunteer group
          of musicians of every age and background.
        </p>
        <p class="pair-body pair-accents">
          Filarmónica Artista Amadora · sopas · linguiça · malassadas
        </p>
        <p class="note">{note}</p>
      </article>
    ))}
  </Section>

  <Section title="Tagline options">
    <ol class="taglines">
      {taglines.map(({ text, source }) => (
        <li>
          <p class="tagline">{text}</p>
          <p class="note">{source}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section title="Portuguese tile pattern">
    <p>
      An <em>azulejo</em>-inspired pattern recolored into our palette instead of the traditional
      blue, for dividers, bands and heritage sections.
    </p>
    <TilePattern />
    <TilePattern colors={{ ground: '#355749', shape: '#00A079', accent: '#F3DD3E' }} />
    <TilePattern
      colors={{ ground: '#FFFFFF', shape: '#F0F0F0', accent: '#FFEB5B' }}
      height="4rem"
      tile={36}
    />
    <TilePattern
      colors={{ ground: '#F3DD3E', shape: '#FFEB5B', accent: '#FFFFFF' }}
      height="2rem"
      tile={24}
    />
  </Section>
</PageLayout>

<style>
  .name-lead {
    font-family: var(--font-heading);
    font-size: var(--step-3);
    color: var(--color-hunter-green);
    line-height: 1.1;
  }

  .name-official {
    font-size: var(--step-1);
    font-style: italic;
  }

  .lockups {
    display: grid;
    gap: var(--space-s);
  }

  .lockup {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-m);
    border-radius: var(--radius);
    border: 1px solid #ddd;
  }

  .lockup.stacked {
    flex-direction: column;
    text-align: center;
  }

  .lockup-name {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.15;
  }

  .lockup-official {
    font-size: var(--step--1);
    font-style: italic;
  }

  .on-white {
    background: #fff;
    color: #355749;
  }

  .on-white :global(.logo) {
    color: #f3dd3e;
  }

  .on-hunter {
    background: #355749;
    color: #fff;
  }

  .on-hunter :global(.logo) {
    color: #f3dd3e;
  }

  .on-gold {
    background: #f3dd3e;
    color: #333;
  }

  .on-gold :global(.logo) {
    color: #333;
  }

  .swatches {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: flex;
    gap: var(--space-s);
    align-items: center;
  }

  .chip {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    border: 1px solid #ccc;
  }

  .uniform {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr;
    border: 1px solid #ccc;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .uniform span {
    padding: var(--space-s);
    color: #fff;
    font-weight: 700;
    font-size: var(--step--1);
  }

  .pairs {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .pairs li {
    display: grid;
    padding: var(--space-s);
    border: 1px solid #ddd;
    border-radius: var(--radius);
  }

  .donate-sample {
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius);
    background: var(--color-gold);
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .font-pair {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-m);
    border: 1px solid #ddd;
    border-radius: var(--radius);
    font-family: var(--body);
  }

  .pair-name {
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pair-h1 {
    font-family: var(--heading);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-hunter-green);
  }

  .pair-h2 {
    font-family: var(--heading);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-hunter-green);
  }

  #fonts-c .pair-h1,
  #fonts-c .pair-h2 {
    font-weight: 400;
  }

  .pair-accents {
    font-style: italic;
  }

  .taglines {
    display: grid;
    gap: var(--space-m);
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    color: var(--color-hunter-green);
  }

  .note {
    font-size: var(--step--1);
    color: #555;
  }
</style>
